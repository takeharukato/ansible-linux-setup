#
# 管理サーバアドレス
# 物理サーバ/管理用VMネットワーク内のIPv4アドレス定義変数
# mgmt_server_ipv4_address, mgmt_server_ipv6_address は,
# vars/all-config.ymlで定義
#

# 仮想環境内部管理ネットワーク内のIPv4アドレスオクテット
gpm_mgmt_mgmt_server_ipv4_addr_octet: "{{ mgmt_server_ipv4_addr_octet }}"
# 仮想環境内部管理ネットワーク内のIPv6アドレスフィールド
gpm_mgmt_mgmt_server_ipv6_addr_field: "{{ mgmt_server_ipv6_addr_field }}"
# 仮想環境内部管理ネットワーク内のIPv4アドレス
gpm_mgmt_mgmt_server_ipv4_address: "{{gpm_mgmt_ipv4_prefix}}.{{ gpm_mgmt_mgmt_server_ipv4_addr_octet }}"
# 仮想環境内部管理ネットワーク内のIPv6アドレス
gpm_mgmt_mgmt_server_ipv6_address: "{{gpm_mgmt_ipv6_prefix}}{{ gpm_mgmt_mgmt_server_ipv6_addr_field }}"

# 管理ネットワークIF
mgmt_nic: "ens160"
# 仮想環境内部管理ネットワークのvNIC
gpm_mgmt_nic: "ens192"

# ネットワークIFリスト
netif_list:
  - netif: "{{mgmt_nic}}"
    mac: "00:50:56:00:f3:71"
    static_ipv4_addr: "{{mgmt_server_ipv4_address}}"
    network_ipv4_prefix_len: "{{network_ipv4_prefix_len}}"
    static_ipv6_addr: "{{mgmt_server_ipv6_address}}"
    network_ipv6_prefix_len: "{{network_ipv6_prefix_len}}"
    gateway4: "{{gateway4}}"
    gateway6: "{{gateway6}}"
    ignore_auto_ipv4_dns: true
    ignore_auto_ipv6_dns: true
    name_server_ipv4_1: "{{ipv4_name_server1}}"
    name_server_ipv4_2: "{{ipv4_name_server2}}"
    name_server_ipv6_1: "{{ipv6_name_server1}}"
    name_server_ipv6_2: "{{ipv6_name_server2}}"
    dns_search: "{{ dns_search }}"
  - netif: "{{gpm_mgmt_nic}}"
    mac: "00:50:56:00:f3:7b"
    static_ipv4_addr: "{{gpm_mgmt_mgmt_server_ipv4_address}}"
    network_ipv4_prefix_len: "{{network_ipv4_prefix_len}}"
    static_ipv6_addr: "{{gpm_mgmt_mgmt_server_ipv6_address}}"
    network_ipv6_prefix_len: "{{network_ipv6_prefix_len}}"
    ignore_auto_ipv4_dns: true
    ignore_auto_ipv6_dns: true
    name_server_ipv4_1: "{{ipv4_name_server1}}"
    name_server_ipv4_2: "{{ipv4_name_server2}}"
    name_server_ipv6_1: "{{ipv6_name_server1}}"
    name_server_ipv6_2: "{{ipv6_name_server2}}"
    dns_search: "{{ dns_search }}"

# ======================================================
# DNSサーバ導入設定 (条件的必須: DNSサーバ機能利用時)
# 以下は, host_vars側で設定する
# ======================================================
#
# DNSサーバ(bind)を導入する
dns_dns_server_enabled: true
# DNSサーバ名 (条件付き必須: dns-server roleが有効な場合に必須)
dns_server: "mgmt-server.{{ dns_domain }}"
# namedのACLに設定するIPv4ネットワークアドレス
dns_network: "{{ network_ipv4_network_address }}"
# ネットワークプレフィクス(IPv4)
# 設定例: 192.168.20
# 上記の後にドットをつけて, 固定IPアドレスのDNS登録を行うため,
# 末尾にドットなどを付けないこと
dns_network_ipv4_prefix: "{{ network_ipv4_prefix }}"
# ネットワークプレフィクス長(IPv4)
dns_network_ipv4_prefix_len: "{{ network_ipv4_prefix_len }}"
# ネットワークプレフィクス(IPv6)
dns_network_ipv6_prefix: "{{ network_ipv6_network_address }}"
# ネットワークプレフィクス長(IPv6)
dns_network_ipv6_prefix_len: "{{ network_ipv6_prefix_len }}"
# IPv6逆引きファイル名
dns_network_ipv6_prefix_filename: "fd69-6684-61a-1"

# =================================================================
# NTPサーバ設定 (条件的必須: NTPサーバ利用時)
# host_vars側で設定し, vars/all-config.ymlには設定しないことを推奨
# =================================================================
#
# NTPサーバの有効化, NTPサーバを導入する場合は true に設定する
ntp_server_enabled: true
# IPv4ネットワークアドレス(未設定時は空文字)
external_ntp_servers_list:
  - ntp.nict.jp
  - jp.pool.ntp.org
  - ntp.jst.mfeed.ad.jp
  - ntp.ring.gr.jp
  - time.google.com
  - time.aws.com
  - ats1.e-timing.ne.jp
  - s2csntp.miz.nao.ac.jp
# NTPクライアントからのアクセス許可ネットワーク
ntp_allow: "{{ network_ipv4_network_address }}/{{ network_ipv4_prefix_len }}"

# ======================================================
# NFSサーバ設定 (条件的必須: NFS利用時)
# host_vars側で設定し, vars/all-config.ymlには設定しないことを推奨
# ======================================================
#
# NFS (Network File System, ネットワーク越しにファイル共有を行う仕組み) サーバを導入する場合は true に設定する
nfs_server_enabled: true
#
# NFS (Network File System) で公開するディレクトリ
nfs_export_directory: "/home/nfsshare"
#
# NFS公開を許可するクライアント側ネットワーク (CIDR 形式)
nfs_network: "{{ network_ipv4_network_address }}/{{ network_ipv4_prefix_len }}"
#
# /etc/exports へ書き込む NFS 公開オプション
# rw: 読み書き可能, no_root_squash: クライアント側 root 権限を制限しない,
# sync: 同期書き込み, no_subtree_check: サブツリーチェックを無効化, no_wdelay: 書き込み遅延を無効化
nfs_options: "rw,no_root_squash,sync,no_subtree_check,no_wdelay"

#
# LDAP設定
#
# LDAPサーバを導入する場合は, trueに設定する
# host_vars側で設定し, vars/all-config.ymlには設定しないことを推奨
ldap_enabled: true

#
# Redmine 設定
#
# Redmineサーバを導入する
redmine_enabled: true

#
# Gitlab 設定
#
# GitLabを導入する
gitlab_enabled: true
# GitLabサーバのWEB UI公開URLのホスト名
gitlab_hostname: "mgmt-server.{{ dns_domain }}"

#
# OpenGrok 設定
#
# OpenGrok サーバを導入する
opengrok_enabled: true
# ソース同期処理ユーザ
opengrok_sync_user_list: []
