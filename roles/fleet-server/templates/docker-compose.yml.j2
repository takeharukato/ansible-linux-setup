#
# fleet-server コンテナを backend ネットワーク上で起動する compose 定義である。
#
services:
  # fleet-server サービス定義
  fleet-server:
    # 利用するイメージを指定する。
    image: "{{ fleet_server_image }}"
    # コンテナ名を設定し, 管理対象を明確にする。
    container_name: "{{ fleet_server_container_name }}"
    # 永続 state を保持し, 再起動時の再登録を防止する。
    user: "{{ logging_backend_container_user }}"
    # Fleet Server動作指示や自己登録に必要な情報を環境変数で提供する:
    # - FLEET_SERVER_ENABLE を true に設定することで, fleet-server を起動する。
    # - FLEET_ENROLL を 1 に設定することで, Fleet Serverコンテナの起動時に
    #   自己登録を実行し, 後続のFleet Bootstrapで, Fleet Server統合の設定前に発生する
    #   `missing config fleet.agent.id`状態を一時的に許容する。
    #   Fleet Server統合作業は, 後続のFleet Bootstrapで実行する。
    # - FLEET_SERVER_ELASTICSEARCH_HOST で Elasticsearchの接続先を指定する。
    # - FLEET_SERVER_SERVICE_TOKEN_PATH で Fleet Serverの自己登録に必要な
    #   サービストークンの格納先を指定する。
    # - FLEET_SERVER_POLICY_ID で Fleet Serverの自己登録に必要な
    #   Agent Policy識別子を指定する。
    # - FLEET_SERVER_HOST で Fleet Serverの自己登録に必要な
    #   ホスト名を指定する。
    # - FLEET_SERVER_PORT で Fleet Serverの自己登録に必要な
    #   ポート番号を指定する。
    # - FLEET_SERVER_INSECURE_HTTP で Fleet Serverの自己登録に必要な
    #   HTTP接続の安全性を指定する。
    # - STATE_PATH で Fleet Serverの永続 state の格納先を/stateに指定する。
    environment:
      - "FLEET_SERVER_ENABLE=true"
      - "FLEET_ENROLL=1"
      - "FLEET_SERVER_ELASTICSEARCH_HOST={{ fleet_server_runtime_elasticsearch_scheme }}://{{ fleet_server_runtime_elasticsearch_host }}:{{ fleet_server_runtime_elasticsearch_port }}"
{% if fleet_server_runtime_elasticsearch_security_enabled | bool %}
      - "FLEET_SERVER_SERVICE_TOKEN_PATH={{ fleet_server_service_token_container_path }}"
{% endif %}
      - "FLEET_SERVER_POLICY_ID={{ fleet_server_policy_id }}"
{% if fleet_server_runtime_elasticsearch_security_enabled | bool %}
      - "FLEET_SERVER_KIBANA_API_KEY={{ fleet_server_runtime_kibana_api_key_value | default('') }}"
{% endif %}
      - "FLEET_SERVER_HOST={{ fleet_server_host }}"
      - "FLEET_SERVER_PORT={{ fleet_server_port }}"
      - "FLEET_SERVER_INSECURE_HTTP={{ (fleet_server_runtime_scheme == 'http') | ternary('true', 'false') }}"
      - "FLEET_SERVER_ELASTICSEARCH_INSECURE={{ (fleet_server_runtime_elasticsearch_api_tls_mode == 'none') | ternary('true', 'false') }}"
      - "STATE_PATH=/state"
    volumes:
      - "{{ fleet_server_runtime_state_dir }}:/state"
{% if fleet_server_runtime_elasticsearch_security_enabled | bool %}
      - "{{ fleet_server_runtime_service_token_path }}:{{ fleet_server_service_token_container_path }}:ro"
{% endif %}
    # fleet-server ポートをホストへ公開する。
    ports:
      - "{{ fleet_server_host }}:{{ fleet_server_port }}:{{ fleet_server_port }}"
    # 異常終了時に自動復旧する。
    restart: unless-stopped
    # backend 用共有ネットワークへ接続する。
    networks:
      - elastic_backend

# ネットワーク定義
networks:
  # 既存の external ネットワークを利用する。
  elastic_backend:
    external: true
    name: "{{ fleet_server_runtime_network_name }}"
