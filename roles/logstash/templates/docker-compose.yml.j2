# This file is generated by ansible.
#
# 生成日時は epoch 秒を日時文字列へ変換して記録する。
# 変換処理の対応関係: 書式指定('%Y-%m-%d %H:%M:%S %Z') + epoch値(ansible_date_time.epoch) を strftime へ渡す ({{ '%Y-%m-%d %H:%M:%S %Z' | strftime(ansible_date_time.epoch) }})。
# last update: {{ '%Y-%m-%d %H:%M:%S %Z' | strftime(ansible_date_time.epoch) }}
#
# Logstash コンテナを backend ネットワーク上で起動する compose 定義である。
#
services:
  # Logstash サービス定義
  logstash:
    # 利用する Logstash イメージを指定する。
    image: "{{ logstash_image }}"
    # コンテナ名を設定し, 運用時の識別を容易にする。
    container_name: "{{ logstash_container_name }}"
    # JVM ヒープを設定し, リソース使用量の上限を明確にする。
    environment:
      # 初期ヒープと最大ヒープを同値で設定し, GC 挙動を安定化する。
      LS_JAVA_OPTS: "-Xms256m -Xmx256m"
    # パイプライン設定, データ, ログをホスト側へ保持する。
    volumes:
      # Logstash パイプライン定義を読み取り専用で渡し, 実行時に入力/出力ルールを固定する。
      - "{{ logstash_pipeline_dir }}/main.conf:/usr/share/logstash/pipeline/logstash.conf:ro"
      # キューや内部状態の保存領域を永続化し, 再起動時のデータ欠落を抑止する。
      - "{{ logstash_data_dir }}:/usr/share/logstash/data"
      # Logstash ログ出力先を永続化し, 運用監視と障害解析で参照できるようにする。
      - "{{ logstash_logs_dir }}:/usr/share/logstash/logs"
    # beats 入力ポートと HTTP 監視ポートをホストへ公開する。
    ports:
      # beats 受信ポートを公開し, Filebeat/Metricbeat からのイベント送信を受け付ける。
      - "{{ logstash_beats_port }}:{{ logstash_beats_port }}"
      # HTTP 監視ポートを公開し, 稼働確認と統計情報取得を可能にする。
      - "{{ logstash_http_port }}:{{ logstash_http_port }}"
    # 異常終了時に自動復旧する。
    restart: unless-stopped
    # backend 用の共有ネットワークに参加する。
    networks:
      - elastic_backend

# ネットワーク定義
networks:
  # 既存の external ネットワークへ接続し, backend サービス間通信を統一する。
  elastic_backend:
    # Compose で新規作成せず, 既存ネットワークを利用する。
    external: true
    # 接続する既存ネットワーク名を設定し, ロール間で同一ネットワークへ参加させる。
    name: "{{ logstash_network_name }}"