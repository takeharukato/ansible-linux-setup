#
#  -*- coding:utf-8 mode: yaml -*-
# This file is generated by ansible.
#
# 生成日時は epoch 秒を日時文字列へ変換して記録する。
# 変換処理の対応関係: 書式指定('%Y-%m-%d %H:%M:%S %Z') + epoch値(ansible_date_time.epoch) を strftime へ渡す ({{ '%Y-%m-%d %H:%M:%S %Z' | strftime(ansible_date_time.epoch) }})。
# last update: {{ '%Y-%m-%d %H:%M:%S %Z' | strftime(ansible_date_time.epoch) }}
#
# Logstash の pipeline を設定し, beats 受信と Elasticsearch 送信を行う。
#
# 入力プラグイン定義を開始し, 受信元ごとの取り込み条件を設定する。
input {
  # beats 入力を有効化し, Filebeat/Metricbeat からのイベント受信を受け付ける。
  beats {
    # beats 待受ポートを設定し, 収集エージェントの送信先ポートを統一する。
    port => {{ logstash_beats_port }}
  }
}

# 出力プラグイン定義を開始し, 受信イベントの保存先を設定する。
output {
  # Elasticsearch 出力を有効化し, 受信イベントを検索基盤へ転送する。
  elasticsearch {
    # Elasticsearch の接続先 URL を設定し, backend コンテナ間通信で送信する。
    hosts => ["http://elasticsearch:9200"]
    # 出力先インデックス名を日次形式で設定し, 日付単位の保管と削除運用を可能にする。
    index => "shared-logs-%{+YYYY.MM.dd}"
  }
}