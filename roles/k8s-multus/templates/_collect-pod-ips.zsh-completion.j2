_collect_pod_ips_get_namespaces() {
  local -a namespaces
  namespaces=($(kubectl get namespaces -o jsonpath='{.items[*].metadata.name}' 2>/dev/null))
  _describe 'namespace' namespaces
}

_collect_pod_ips_get_label_selectors() {
  local -a label_keys
  local -a selectors
  local label_key

{% raw %}
  label_keys=($(kubectl get pods -A \
    -o go-template='{{range .items}}{{range $k, $_ := .metadata.labels}}{{printf "%s\n" $k}}{{end}}{{end}}' \
    2>/dev/null | sort -u))
{% endraw %}

  for label_key in "${label_keys[@]}"; do
    selectors+=("${label_key}=")
    selectors+=("${label_key}!=")
  done

  _describe 'label selector' selectors
}

_collect_pod_ips_get_field_selectors() {
  local -a field_selectors
  field_selectors=(
    'metadata.name='
    'metadata.namespace='
    'spec.nodeName='
    'spec.serviceAccountName='
    'status.phase='
    'status.podIP='
  )
  _describe 'field selector' field_selectors
}

_collect_pod_ips() {
  local context state line
  typeset -A opt_args

  _arguments -C \
    '--namespace[Target namespace. If omitted, all namespaces are included.]:namespace:->namespace' \
    '--label-selector[Kubernetes label selector.]:label selector:->label_selector' \
    '--field-selector[Kubernetes field selector.]:field selector:->field_selector' \
    '--in-cluster[Use the ServiceAccount credentials from inside the Pod.]' \
    '--kubeconfig[Path to kubeconfig file. Ignored when --in-cluster is set.]:kubeconfig file:_files' \
    '--include-empty[Include Pods for which no IP address could be retrieved.]' \
    '--strict[Return exit code 1 when warnings or interfaces without reported IPs are present.]' \
    '--debug[Enable verbose logging.]' \
    '--help[Show help message.]'

  case "${state}" in
    namespace)
      _collect_pod_ips_get_namespaces
      ;;
    label_selector)
      _collect_pod_ips_get_label_selectors
      ;;
    field_selector)
      _collect_pod_ips_get_field_selectors
      ;;
  esac
}

_collect_pod_ips "$@"
