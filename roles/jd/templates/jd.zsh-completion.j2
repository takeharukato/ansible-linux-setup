#compdef jd
# -*- coding: utf-8; mode: zsh -*-
#
# jd command completion for zsh
# jd用のzsh補完スクリプト
#
# This file is generated by ansible.
{# 日付の取得 #}
# last update: {{ '%Y-%m-%d %H:%M:%S %Z' | strftime(ansible_date_time.epoch) }}
#

_jd() {
  _arguments -s \
    '-color[Print color diff]' \
    '-color-words[Print color diff with character-level highlighting]' \
    '-f[Diff format]:format:(jd patch merge)' \
    '-git-diff-driver[Use jd as a git diff driver]' \
    '-mset[Arrays as multisets]' \
    '-o[Output file]:file:_files' \
    '-opts[JSON array of options]:json options:' \
    '-p[Patch mode]' \
    '-port[Serve web UI on port]:port:' \
    '-precision[Maximum absolute difference]:precision:' \
    '-set[Arrays as sets]' \
    '-setkeys[Keys to identify set objects]:keys:' \
    '-t[Translate mode]:translation:(jd2patch patch2jd jd2merge merge2jd json2yaml yaml2json)' \
    '-v2[Use the jd v2 library]' \
    '-version[Print version and exit]' \
    '-yaml[Read and write YAML instead of JSON]' \
    '*:file:_files'
}

_jd "$@"
