# -*- coding: utf-8; mode: bash -*-
#
# jd command completion for bash
# jd用のbash補完スクリプト
#
# This file is generated by ansible.
{# 日付の取得 #}
# last update: {{ '%Y-%m-%d %H:%M:%S %Z' | strftime(ansible_date_time.epoch) }}
#

_jd() {
    local cur prev opts
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    opts="-color -color-words -f -git-diff-driver -mset -o -opts -p -port -precision -set -setkeys -t -v2 -version -yaml --help -h"

    case "${prev}" in
        -f)
            COMPREPLY=( $(compgen -W "jd patch merge" -- "${cur}") )
            return 0
            ;;
        -t)
            COMPREPLY=( $(compgen -W "jd2patch patch2jd jd2merge merge2jd json2yaml yaml2json" -- "${cur}") )
            return 0
            ;;
        -o)
            COMPREPLY=( $(compgen -f -- "${cur}") )
            return 0
            ;;
    esac

    if [[ "${cur}" == -* ]]; then
        COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
    else
        COMPREPLY=( $(compgen -f -- "${cur}") )
    fi
}

complete -F _jd jd
