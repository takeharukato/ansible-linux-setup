#!/usr/bin/env bash
# -*- coding:utf-8 mode:bash -*-
#
# jdのdebパッケージをビルドする
#
# 実行時パラメタ環境変数
#  - JD_VERSION_TAG: ソース取得用タグ (例: v2.1.2)
#  - JD_VERSION_NORMALIZED: パッケージ版数 (例: 2.1.2)
#  - JD_SOURCE_BASE_URL: jdソース取得先ベースURL
#  - JD_DEB_PACKAGE_NAME: 生成するdebパッケージ名
#  - JD_COMMAND_PATH: インストール先コマンドパス
#  - JD_DEB_ARCH: debパッケージ用アーキテクチャ名
#
# This file is generated by ansible.
{# 日付の取得 #}
# last update: {{ '%Y-%m-%d %H:%M:%S %Z' | strftime(ansible_date_time.epoch) }}

set -euo pipefail

: "${JD_VERSION_TAG:?JD_VERSION_TAG is required}"
: "${JD_VERSION_NORMALIZED:?JD_VERSION_NORMALIZED is required}"
: "${JD_SOURCE_BASE_URL:?JD_SOURCE_BASE_URL is required}"
: "${JD_DEB_PACKAGE_NAME:?JD_DEB_PACKAGE_NAME is required}"
: "${JD_COMMAND_PATH:?JD_COMMAND_PATH is required}"
: "${JD_DEB_ARCH:?JD_DEB_ARCH is required}"
: "${JD_COMPLETION_ENABLED:=false}"
: "${JD_BASH_COMPLETION_PATH_DEBIAN:=/usr/share/bash-completion/completions/jd}"
: "${JD_ZSH_COMPLETION_PATH_DEBIAN:=/usr/share/zsh/vendor-completions/_jd}"
: "${JD_BASH_COMPLETION_SRC:={{ jd_build_container_workdir }}/jd.bash-completion}"
: "${JD_ZSH_COMPLETION_SRC:={{ jd_build_container_workdir }}/jd.zsh-completion}"

JD_BASH_COMPLETION_PATH="${JD_BASH_COMPLETION_PATH_DEBIAN}"
JD_ZSH_COMPLETION_PATH="${JD_ZSH_COMPLETION_PATH_DEBIAN}"

workdir="{{ jd_build_container_workdir }}"
outdir="${workdir}/output"
stage_dir="${workdir}/jd-deb-stage"
pkgroot="${stage_dir}/root"
control_dir="${pkgroot}/DEBIAN"
src_tarball="${workdir}/jd-${JD_VERSION_TAG}.tar.gz"
src_dir="${workdir}/jd-${JD_VERSION_NORMALIZED}"
cmd_parent="$(dirname "${JD_COMMAND_PATH}")"
bash_completion_parent="$(dirname "${JD_BASH_COMPLETION_PATH}")"
zsh_completion_parent="$(dirname "${JD_ZSH_COMPLETION_PATH}")"

is_true() {
    case "${1:-}" in
        true|TRUE|yes|YES|1)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

prepare_tools() {
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install {{ apt_install_opts }} \
        ca-certificates \
        curl \
        git \
        golang-go \
        dpkg-dev \
        file
}

build_jd_binary() {
    local built_binary

    if [ -d "${src_dir}" ]; then
        rm -rf "${src_dir:?}"
    fi

    curl -fsSL "${JD_SOURCE_BASE_URL}/${JD_VERSION_TAG}.tar.gz" -o "${src_tarball}"
    tar -xzf "${src_tarball}" -C "${workdir}"

    export CGO_ENABLED=0
    built_binary="${workdir}/jd"

    if [ -f "${src_dir}/v2/go.mod" ] && [ -d "${src_dir}/v2/jd" ]; then
        # jd は v2 が独立した Go モジュールのため, v2 配下でビルドする
        (
            cd "${src_dir}/v2"
            go build -trimpath -ldflags "-s -w" -o "${built_binary}" ./jd
        )
        return
    fi

    if [ -f "${src_dir}/go.mod" ]; then
        (
            cd "${src_dir}"
            go build -trimpath -ldflags "-s -w" -o "${built_binary}" .
        )
        return
    fi

    echo "No buildable jd module found in ${src_dir}" >&2
    return 1
}

build_package() {
    local installed_size

    if [ -d "${stage_dir}" ]; then
        rm -rf "${stage_dir:?}/"*
    fi

    mkdir -p "${outdir}" "${control_dir}" "${pkgroot}${cmd_parent}"
    install -m 0755 "${workdir}/jd" "${pkgroot}${JD_COMMAND_PATH}"

    if is_true "${JD_COMPLETION_ENABLED}"; then
        if [ ! -f "${JD_BASH_COMPLETION_SRC}" ]; then
            echo "Missing bash completion source: ${JD_BASH_COMPLETION_SRC}" >&2
            return 1
        fi
        if [ ! -f "${JD_ZSH_COMPLETION_SRC}" ]; then
            echo "Missing zsh completion source: ${JD_ZSH_COMPLETION_SRC}" >&2
            return 1
        fi
        mkdir -p "${pkgroot}${bash_completion_parent}" "${pkgroot}${zsh_completion_parent}"
        install -m 0644 "${JD_BASH_COMPLETION_SRC}" "${pkgroot}${JD_BASH_COMPLETION_PATH}"
        install -m 0644 "${JD_ZSH_COMPLETION_SRC}" "${pkgroot}${JD_ZSH_COMPLETION_PATH}"
    fi

    installed_size="$(du -ks "${pkgroot}" | awk '{print $1}')"

    cat > "${control_dir}/control" <<EOF
Package: ${JD_DEB_PACKAGE_NAME}
Version: ${JD_VERSION_NORMALIZED}-1
Section: utils
Priority: optional
Architecture: ${JD_DEB_ARCH}
Maintainer: jd role builder <root@localhost>
Installed-Size: ${installed_size}
Description: jd command line JSON/YAML diff and patch tool ${JD_VERSION_TAG}
EOF

    dpkg-deb --build "${pkgroot}" "${outdir}/${JD_DEB_PACKAGE_NAME}_${JD_VERSION_NORMALIZED}-1_${JD_DEB_ARCH}.deb"
}

main() {
    prepare_tools
    build_jd_binary
    build_package
}

main "$@"
