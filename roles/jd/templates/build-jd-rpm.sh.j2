#!/usr/bin/env bash
# -*- coding:utf-8 mode:bash -*-
#
# jdのrpmパッケージをビルドする
#
# 実行時パラメタ環境変数
#  - JD_VERSION_TAG: ソース取得用タグ (例: v2.1.2)
#  - JD_VERSION_NORMALIZED: パッケージ版数 (例: 2.1.2)
#  - JD_SOURCE_BASE_URL: jdソース取得先ベースURL
#  - JD_RPM_PACKAGE_NAME: 生成するrpmパッケージ名
#  - JD_COMMAND_PATH: インストール先コマンドパス
#  - JD_RPM_ARCH: rpmパッケージ用アーキテクチャ名
#
# This file is generated by ansible.
{# 日付の取得 #}
# last update: {{ '%Y-%m-%d %H:%M:%S %Z' | strftime(ansible_date_time.epoch) }}

set -euo pipefail

: "${JD_VERSION_TAG:?JD_VERSION_TAG is required}"
: "${JD_VERSION_NORMALIZED:?JD_VERSION_NORMALIZED is required}"
: "${JD_SOURCE_BASE_URL:?JD_SOURCE_BASE_URL is required}"
: "${JD_RPM_PACKAGE_NAME:?JD_RPM_PACKAGE_NAME is required}"
: "${JD_COMMAND_PATH:?JD_COMMAND_PATH is required}"
: "${JD_RPM_ARCH:?JD_RPM_ARCH is required}"
: "${JD_COMPLETION_ENABLED:=false}"
: "${JD_BASH_COMPLETION_PATH_RHEL:=/usr/share/bash-completion/completions/jd}"
: "${JD_ZSH_COMPLETION_PATH_RHEL:=/usr/share/zsh/site-functions/_jd}"
: "${JD_BASH_COMPLETION_SRC:={{ jd_build_container_workdir }}/jd.bash-completion}"
: "${JD_ZSH_COMPLETION_SRC:={{ jd_build_container_workdir }}/jd.zsh-completion}"

JD_BASH_COMPLETION_PATH="${JD_BASH_COMPLETION_PATH_RHEL}"
JD_ZSH_COMPLETION_PATH="${JD_ZSH_COMPLETION_PATH_RHEL}"

workdir="{{ jd_build_container_workdir }}"
outdir="${workdir}/output"
rpmbuild_dir="${workdir}/rpmbuild"
source_tarball="jd-${JD_VERSION_TAG}.tar.gz"
source_dir_name="jd-${JD_VERSION_NORMALIZED}"
cmd_parent="$(dirname "${JD_COMMAND_PATH}")"
bash_completion_parent="$(dirname "${JD_BASH_COMPLETION_PATH}")"
zsh_completion_parent="$(dirname "${JD_ZSH_COMPLETION_PATH}")"

is_true() {
    case "${1:-}" in
        true|TRUE|yes|YES|1)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

prepare_tools() {

    # curl-minimal と curl が競合する環境があるため,
    # 先に既存の curl コマンド有無を確認し, 未導入時のみ補完する
    # パッケージ構築にEPELは不要であるため,
    # 応答不良のミラーで停止しないよう EPEL を無効化
    dnf {{ dnf_install_opts }} --disablerepo=epel install \
        ca-certificates \
        git \
        golang \
        rpm-build \
        findutils \
        tar \
        gzip

    if ! command -v curl >/dev/null 2>&1; then
        dnf {{ dnf_install_opts }} --disablerepo=epel install curl-minimal || dnf {{ dnf_install_opts }} --disablerepo=epel install --allowerasing curl
    fi
}

prepare_sources() {
    rm -rf "${rpmbuild_dir}"
    mkdir -p "${rpmbuild_dir}"/{BUILD,BUILDROOT,RPMS,SOURCES,SPECS,SRPMS}
    mkdir -p "${outdir}"

    curl {{ curl_common_opts }} -fsSL "${JD_SOURCE_BASE_URL}/${JD_VERSION_TAG}.tar.gz" -o "${rpmbuild_dir}/SOURCES/${source_tarball}"
}

write_spec() {
    local with_completion

    with_completion=0
    if is_true "${JD_COMPLETION_ENABLED}"; then
        with_completion=1
    fi

    cat > "${rpmbuild_dir}/SPECS/${JD_RPM_PACKAGE_NAME}.spec" <<EOF
%global debug_package %{nil}
%global _debugsource_packages 0
%global with_completion ${with_completion}
Name:           ${JD_RPM_PACKAGE_NAME}
Version:        ${JD_VERSION_NORMALIZED}
Release:        1%{?dist}
Summary:        jd command line JSON/YAML diff and patch tool
License:        MIT
URL:            https://github.com/josephburnett/jd
Source0:        ${source_tarball}
BuildArch:      ${JD_RPM_ARCH}

%description
jd command line JSON/YAML diff and patch tool ${JD_VERSION_TAG}

%prep
%setup -q -n ${source_dir_name}

%build
export CGO_ENABLED=0
if [ -f ./v2/go.mod ] && [ -d ./v2/jd ]; then
    cd ./v2
    go build -trimpath -ldflags "-s -w" -o "%{_builddir}/${source_dir_name}/jd" ./jd
elif [ -f ./go.mod ]; then
    go build -trimpath -ldflags "-s -w" -o "%{_builddir}/${source_dir_name}/jd" .
else
    echo "No buildable jd module found in %{_builddir}/${source_dir_name}" >&2
    exit 1
fi

%install
rm -rf %{buildroot}
mkdir -p %{buildroot}${cmd_parent}
install -m 0755 "%{_builddir}/${source_dir_name}/jd" %{buildroot}${JD_COMMAND_PATH}

if [ 0%{?with_completion} -eq 1 ]; then
    if [ ! -f "${JD_BASH_COMPLETION_SRC}" ]; then
        echo "Missing bash completion source: ${JD_BASH_COMPLETION_SRC}" >&2
        exit 1
    fi
    if [ ! -f "${JD_ZSH_COMPLETION_SRC}" ]; then
        echo "Missing zsh completion source: ${JD_ZSH_COMPLETION_SRC}" >&2
        exit 1
    fi
    mkdir -p %{buildroot}${bash_completion_parent}
    mkdir -p %{buildroot}${zsh_completion_parent}
    install -m 0644 ${JD_BASH_COMPLETION_SRC} %{buildroot}${JD_BASH_COMPLETION_PATH}
    install -m 0644 ${JD_ZSH_COMPLETION_SRC} %{buildroot}${JD_ZSH_COMPLETION_PATH}
fi

%files
${JD_COMMAND_PATH}
%if 0%{?with_completion}
${JD_BASH_COMPLETION_PATH}
${JD_ZSH_COMPLETION_PATH}
%endif
EOF
}

build_package() {
    rpmbuild -bb "${rpmbuild_dir}/SPECS/${JD_RPM_PACKAGE_NAME}.spec" --define "_topdir ${rpmbuild_dir}"
    find "${rpmbuild_dir}/RPMS" -type f -name '*.rpm' -exec cp -f {} "${outdir}/" \;
}

main() {
    prepare_tools
    prepare_sources
    write_spec
    build_package
}

main "$@"
