"""Elasticsearchのスナップショットバックアップを実行する。

filesystem repository を登録し, Snapshot 作成後に保持世代を超えた
過去スナップショットを削除する。
"""

from __future__ import annotations

import argparse
import datetime
import json
import logging
import urllib.error
import urllib.parse
import urllib.request
from dataclasses import dataclass
from typing import Any

# ロガーを作成する。ログ名は "elasticsearch-backup" とする。
LOGGER: logging.Logger = logging.getLogger("elasticsearch-backup")


@dataclass(frozen=True)
class BackupConfig:
    """バックアップ実行時の設定を保持するデータクラスである。

    Attributes:
        endpoint (str): Elasticsearch の接続先 URL。
        repository (str): Snapshot Repository 名。
        repository_path (str): コンテナ内の repository パス。
        snapshot_prefix (str): snapshot 名の接頭辞。
        retention (int): 保持世代数。
        timeout_seconds (int): HTTP API 呼び出しタイムアウト秒数。

    Examples:
        >>> cfg = BackupConfig(
        ...     endpoint="http://127.0.0.1:9200",
        ...     repository="elastic-backup-repo",
        ...     repository_path="/usr/share/elasticsearch/snapshot-repo",
        ...     snapshot_prefix="elastic-snapshot",
        ...     retention=7,
        ...     timeout_seconds=120,
        ... )
        >>> cfg.retention
        7
    """

    endpoint: str
    repository: str
    repository_path: str
    snapshot_prefix: str
    retention: int
    timeout_seconds: int


def parse_args() -> argparse.Namespace:
    """コマンドライン引数を解析する。

    Returns:
        argparse.Namespace: 解析済み引数。

    Examples:
        >>> import sys
        >>> _old = sys.argv[:]
        >>> sys.argv = ["backup-elasticsearch-data.py", "--retention", "5"]
        >>> ns = parse_args()
        >>> ns.retention
        5
        >>> sys.argv = _old
    """

    #
    # バックアップ実行パラメータを引数として受け取る。
    #
    parser: argparse.ArgumentParser = argparse.ArgumentParser(
        description="Create Elasticsearch snapshot and prune old snapshots"
    )

    # Elasticsearch endpoint URLを受け取る引数を追加する。
    parser.add_argument(
        "--endpoint",
        default="http://127.0.0.1:{{ elastic_search_http_port }}",
        help="Elasticsearch endpoint URL",
    )

    # Snapshot Repository 名を受け取る引数を追加する。
    parser.add_argument(
        "--repository",
        default="{{ elastic_search_snapshot_repository }}",
        help="Snapshot repository name",
    )

    # コンテナ内の repository パスを受け取る引数を追加する。
    parser.add_argument(
        "--repository-path",
        default="{{ elastic_search_snapshot_repo_path_container }}",
        help="Snapshot repository path on container side",
    )

    # snapshot 名の接頭辞を受け取る引数を追加する。
    parser.add_argument(
        "--snapshot-prefix",
        default="{{ elastic_search_backup_name_prefix }}",
        help="Snapshot name prefix",
    )

    # 保持世代数を受け取る引数を追加する。
    parser.add_argument(
        "--retention",
        type=int,
        default={{ elastic_search_backup_retention }},
        help="Number of snapshots to retain",
    )

    # HTTP API 呼び出しタイムアウト秒数を受け取る引数を追加する。
    parser.add_argument(
        "--timeout-seconds",
        type=int,
        default=120,
        help="HTTP timeout in seconds",
    )

    # 詳細ログを有効化する引数を追加する。
    parser.add_argument(
        "--verbose",
        action="store_true",
        help="Enable verbose logging",
    )

    # 解析済み引数を返す。
    return parser.parse_args()


def setup_logging(verbose: bool) -> None:
    """ログ出力を初期化する。

    Args:
        verbose (bool): 詳細ログを有効化するかを示すフラグ。

    Returns:
        None: 戻り値はない。

    Examples:
        >>> setup_logging(False)
    """

    #
    # verbose 指定に応じてログレベルを切り替える。
    #

    # ログレベルを設定する。verbose が True の場合は DEBUG, それ以外は INFO。
    level: int = logging.DEBUG if verbose else logging.INFO
    # logging.basicConfig() を呼び出すことで, ルートロガーの設定を行う。
    logging.basicConfig(level=level, format="%(asctime)s %(levelname)s %(message)s")


def request_json(
    method: str,
    url: str,
    timeout_seconds: int,
    payload: dict[str, Any] | None = None,
) -> Any:
    """Elasticsearch HTTP API を呼び出し, JSON を返す。

    Args:
        method (str): HTTP メソッド。
        url (str): 呼び出し先 URL。
        timeout_seconds (int): タイムアウト秒数。
        payload (dict[str, Any] | None): JSON 送信本文。

    Returns:
        Any: API 応答の JSON デコード結果。

    Raises:
        RuntimeError: HTTP エラー, URL エラー, 応答本文の文字コード不正,
            または JSON 形式の不正が発生した場合。

    Examples:
        >>> isinstance(request_json("GET", "http://127.0.0.1:9200", 1), dict)  # doctest: +SKIP
        True
    """

    #
    # payload がある場合のみ JSON ボディを構築し, リクエストを作成する。
    #
    data_bytes: bytes | None = None
    headers: dict[str, str] = {"Accept": "application/json"}

    if payload is not None: # payload が None でない場合は JSON ボディを構築する。
        data_bytes = json.dumps(payload).encode("utf-8")
        headers["Content-Type"] = "application/json"

    # HTTP リクエストを作成する。
    # - url: 呼び出し先 URL
    # - method: HTTP メソッド
    # - data: JSON ボディ（payload が None の場合は None）
    # - headers: HTTP ヘッダ（Accept と Content-Type を設定）
    req: urllib.request.Request = urllib.request.Request(
        url=url,
        method=method,
        data=data_bytes,
        headers=headers,
    )

    #
    # HTTP 呼び出しを実施し, 失敗時は原因を含む例外へ変換する。
    #
    try:
        with urllib.request.urlopen(req, timeout=timeout_seconds) as response:
            # HTTP 応答本文を読み込み, UTF-8 文字列に変換する。
            body: str = response.read().decode("utf-8")
    except urllib.error.HTTPError as exc: # HTTP エラーが発生した場合の処理
        # エラー応答本文を読み込み, UTF-8 文字列に変換する。エラー応答本文が不正な場合は置換文字を使用する。
        err_body: str = exc.read().decode("utf-8", errors="replace")
        # HTTP エラーを RuntimeError に変換して再スローする。
        # エラーコードと URL, エラー応答本文を含む。
        raise RuntimeError(f"HTTP error {exc.code} on {url}: {err_body}") from exc
    except urllib.error.URLError as exc: # URL エラーが発生した場合の処理
        # URL エラーを RuntimeError に変換して再スローする。
        raise RuntimeError(f"URL error on {url}: {exc}") from exc
    except UnicodeDecodeError as exc: # 応答本文の文字コードが不正な場合の処理
        # 文字コードの不正を RuntimeError に変換して再スローする。
        raise RuntimeError(f"Failed to decode response from {url}: {exc}") from exc

    if not body: # 応答本文が空の場合は空の辞書を返す。
        return {}
    # 応答本文を JSON としてデコードし, 結果を返す。
    # json.loads() は JSONDecodeError をスローする可能性があるので
    # 呼び出し元で例外処理を行う。
    try:
        return json.loads(body)
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"Failed to decode JSON response from {url}: {body}") from exc

def ensure_repository(config: BackupConfig) -> None:
    """Snapshot Repository を登録する。

    Args:
        config (BackupConfig): Repository 登録に必要な設定値。

    Returns:
        None: 戻り値はない。

    Raises:
        RuntimeError: Repository 登録が acknowledge されない場合。

    Examples:
        >>> cfg = BackupConfig("http://127.0.0.1:9200", "repo", "/repo", "prefix", 7, 120)
        >>> ensure_repository(cfg)  # doctest: +SKIP
    """

    #
    # filesystem repository を作成/更新する。
    #

    # repository 名を URL エンコードする。安全な文字はエンコードしない。
    encoded_repo: str = urllib.parse.quote(config.repository, safe="")
    # repository 登録 API の URL を構築する。
    url: str = f"{config.endpoint}/_snapshot/{encoded_repo}"
    # repository 登録用の JSON ペイロードを構築する。
    # - type: "fs" を指定し, location にコンテナ内の repository パスを設定する。
    # - compress: True を指定してスナップショットを圧縮する。
    payload: dict[str, Any] = {
        "type": "fs",
        "settings": {
            "location": config.repository_path,
            "compress": True,
        },
    }

    # HTTP PUT リクエストを送信し, 応答 JSON を取得する。
    try:
        response_json: Any = request_json("PUT", url, config.timeout_seconds, payload)
    except RuntimeError as exc:
        # Repository 登録が失敗した場合は, RuntimeError をスローする。
        raise RuntimeError(f"Failed to register snapshot repository: {exc}") from exc
    # 応答 JSON から "acknowledged" フィールドを取得し, True であることを確認する。
    acknowledged: bool = bool(response_json.get("acknowledged", False))
    if not acknowledged: # Repository 登録が失敗した場合は, RuntimeError をスローする。
        raise RuntimeError("Snapshot repository registration was not acknowledged")


def build_snapshot_name(prefix: str) -> str:
    """タイムスタンプ付き Snapshot 名を生成する。

    Args:
        prefix (str): snapshot 名の接頭辞。

    Returns:
        str: 生成した snapshot 名。形式は "{prefix}-{YYYYMMDD-HHMMSS}"。

    Examples:
        >>> build_snapshot_name("elastic-snapshot").startswith("elastic-snapshot-")
        True
    """

    #
    # UTC 時刻を用いて snapshot 名を一意化する。
    #
    now: datetime.datetime = datetime.datetime.now(datetime.timezone.utc)
    # snapshot 名を "{prefix}-{YYYYMMDD-HHMMSS}" 形式で生成する。
    return f"{prefix}-{now.strftime('%Y%m%d-%H%M%S')}"


def create_snapshot(config: BackupConfig, snapshot_name: str) -> None:
    """Snapshot を作成する。

    Args:
        config (BackupConfig): snapshot 作成に必要な設定値。
        snapshot_name (str): 作成する snapshot 名。

    Returns:
        None: 戻り値はない。

    Raises:
        RuntimeError: snapshot 作成状態が `SUCCESS` 以外の場合。

    Examples:
        >>> cfg = BackupConfig("http://127.0.0.1:9200", "repo", "/repo", "prefix", 7, 120)
        >>> create_snapshot(cfg, "prefix-20260101-000000")  # doctest: +SKIP
    """

    #
    # snapshot 作成 API の URL を構築する。
    #
    # repository 名と snapshot 名を URL エンコードする。安全な文字はエンコードしない。
    encoded_repo: str = urllib.parse.quote(config.repository, safe="")
    # snapshot 名を URL エンコードする。安全な文字はエンコードしない。
    encoded_snapshot: str = urllib.parse.quote(snapshot_name, safe="")
    # snapshot 作成 API の URL を構築する。wait_for_completion=true を指定して, 作成完了まで待機する。
    url: str = (
        f"{config.endpoint}/_snapshot/{encoded_repo}/{encoded_snapshot}"
        "?wait_for_completion=true"
    )
    # snapshot 作成用の JSON ペイロードを構築する。
    # - include_global_state: False を指定して, クラスタ全体の状態を
    #   snapshot に含めないようにする。
    # - metadata: snapshot 作成者と接頭辞をメタデータとして設定する。
    # - created_by: "ansible-elasticsearch-role" を指定して, 作成者を明示する。
    # - snapshot_prefix: snapshot 名の接頭辞を設定する。
    payload: dict[str, Any] = {
        "include_global_state": False,
        "metadata": {
            "created_by": "ansible-elasticsearch-role",
            "snapshot_prefix": config.snapshot_prefix,
        },
    }

    #
    # HTTP PUT リクエストを送信し, 応答 JSON を取得する。
    #

    try:
        response_json: Any = request_json("PUT", url, config.timeout_seconds, payload)
    except RuntimeError as exc:
        # Snapshot 作成が失敗した場合は, RuntimeError をスローする。
        raise RuntimeError(f"Failed to create snapshot: {exc}") from exc

    # 応答 JSON から "snapshot" フィールドを取得する。
    snapshot_info: dict[str, Any] = dict(response_json.get("snapshot", {}))
    # snapshot_info から "state" フィールドを取得し, `SUCCESS` であることを確認する。
    state: str = str(snapshot_info.get("state", ""))
    if state != "SUCCESS": # snapshot 作成が失敗した場合は, RuntimeError をスローする。
        raise RuntimeError(f"Snapshot creation failed, state={state}")


def list_snapshots(config: BackupConfig) -> list[dict[str, Any]]:
    """Repository 内の Snapshot 一覧を取得する。

    Args:
        config (BackupConfig): Snapshot 一覧取得に必要な設定値。

    Returns:
        list[dict[str, Any]]: Snapshot 情報配列。

    Raises:
        RuntimeError: API 応答形式が想定と異なる場合。

    Examples:
        >>> cfg = BackupConfig("http://127.0.0.1:9200", "repo", "/repo", "prefix", 7, 120)
        >>> list_snapshots(cfg)  # doctest: +SKIP
        []
    """

    #
    # _all API の結果から辞書型要素のみ抽出する。
    #
    # repository 名を URL エンコードする。安全な文字はエンコードしない。
    encoded_repo: str = urllib.parse.quote(config.repository, safe="")
    # _all API の URL を構築する。
    # urlの形式は, "{endpoint}/_snapshot/{encoded_repo}/_all" となる。
    url: str = f"{config.endpoint}/_snapshot/{encoded_repo}/_all"
    # HTTP GET リクエストを送信し, 応答 JSON を取得する。
    try:
        response_json: Any = request_json("GET", url, config.timeout_seconds)
    except RuntimeError as exc:
        # Snapshot 一覧取得が失敗した場合は, RuntimeError をスローする。
        raise RuntimeError(f"Failed to list snapshots: {exc}") from exc
    # API 応答から "snapshots" フィールドを取得し, リスト型であることを確認する。
    snapshots_raw: Any = response_json.get("snapshots", [])
    if not isinstance(snapshots_raw, list):
        # snapshots フィールドがリスト型でない場合は, RuntimeError をスローする。
        raise RuntimeError("Invalid snapshot list response format")

    #
    # 応答結果の解析
    #
    snapshots: list[dict[str, Any]] = []
    # snapshots_raw の各要素をsnapshot 情報として抽出する。
    # 要素が辞書型である場合のみ snapshots に追加する。
    for item in snapshots_raw:
        if isinstance(item, dict):
            snapshots.append(item)
    # snapshots を返す。
    return snapshots


def prune_snapshots(config: BackupConfig) -> None:
    """保持世代を超えた Snapshot を削除する。

    Args:
        config (BackupConfig): 世代整理に必要な設定値。

    Returns:
        None: 戻り値はない。
    Raises:
        RuntimeError: Snapshot 削除が失敗した場合。

    Examples:
        >>> cfg = BackupConfig("http://127.0.0.1:9200", "repo", "/repo", "prefix", 7, 120)
        >>> prune_snapshots(cfg)  # doctest: +SKIP
    """

    #
    # prefix 一致の snapshot を新しい順で並べ, retention 超過分を削除する。
    #
    snapshots: list[dict[str, Any]] = list_snapshots(config)
    filtered: list[dict[str, Any]] = []

    #
    # snapshots の各要素を確認し, snapshot 名が指定 prefix で始まるもののみを filtered に追加する。
    #
    for item in snapshots:
        name_value: str = str(item.get("snapshot", ""))
        if name_value.startswith(f"{config.snapshot_prefix}-"):
            filtered.append(item)

    # start_time で降順にソートする。
    filtered.sort(key=lambda x: str(x.get("start_time", "")), reverse=True)
    # 保持世代を超えた snapshot を削除するため,
    # retention 超過分を stale に格納する。
    stale: list[dict[str, Any]] = filtered[config.retention :]

    # retention 超過分の snapshot を削除する。
    for item in stale:
        name_value = str(item.get("snapshot", ""))
        # repository 名と snapshot 名を URL エンコードする。安全な文字はエンコードしない。
        encoded_repo: str = urllib.parse.quote(config.repository, safe="")
        # snapshot 名を URL エンコードする。安全な文字はエンコードしない。
        encoded_snapshot: str = urllib.parse.quote(name_value, safe="")
        # snapshot 削除 API の URL を構築する。
        # urlの形式は, "{endpoint}/_snapshot/{encoded_repo}/{encoded_snapshot}" となる。
        url: str = f"{config.endpoint}/_snapshot/{encoded_repo}/{encoded_snapshot}"

        #
        # DELETE リクエストを送信し, 古いsnapshot を削除する。
        #
        # 削除前にログ出力する。
        LOGGER.info("Delete stale snapshot: %s", name_value)
        # DELETE リクエストを送信し, 古い snapshot を削除する。
        try:
            request_json("DELETE", url, config.timeout_seconds)
        except RuntimeError as exc:
            # Snapshot 削除が失敗した場合は, RuntimeError をスローする。
            raise RuntimeError(f"Failed to delete snapshot {name_value}: {exc}") from exc

def main() -> int:
    """バックアップ実行のエントリポイントである。

    Returns:
        int: 正常終了時は 0 を返す。

    Raises:
        ValueError: retention が 1 未満の場合。

    Examples:
        >>> isinstance(main(), int)  # doctest: +SKIP
        True
    """

    #
    # 引数を検証し, repository 登録, snapshot 作成, 世代整理を順に実行する。
    #
    args: argparse.Namespace = parse_args()

    # ログ出力を初期化する。verbose 指定に応じてログレベルを切り替える。
    setup_logging(args.verbose)

    if args.retention <= 0: # 不正な世代数指定の場合, ValueError をスローする。
        raise ValueError("--retention must be greater than 0")

    # 引数から BackupConfig を構築する。
    config: BackupConfig = BackupConfig(
        endpoint=str(args.endpoint).rstrip("/"),
        repository=str(args.repository),
        repository_path=str(args.repository_path),
        snapshot_prefix=str(args.snapshot_prefix),
        retention=int(args.retention),
        timeout_seconds=int(args.timeout_seconds),
    )

    #
    # Elasticsearch に対して repository 登録, snapshot 作成, 世代整理を順に実行する。
    #

    # Snapshot Repository を登録する。
    LOGGER.info("Ensure repository: %s", config.repository)
    ensure_repository(config)

    # Snapshot 名を生成し, snapshot を作成する。
    snapshot_name: str = build_snapshot_name(config.snapshot_prefix)
    LOGGER.info("Create snapshot: %s", snapshot_name)
    create_snapshot(config, snapshot_name)

    # 保持世代を超えた snapshot を削除する。
    LOGGER.info("Prune snapshots beyond retention=%d", config.retention)
    prune_snapshots(config)
    LOGGER.info("Backup completed successfully")
    return 0


if __name__ == "__main__":
    try:
        # main() を呼び出し, 正常終了時は 0 を返す。
        raise SystemExit(main())
    except Exception as exc:  # noqa: BLE001
        # 例外が発生した場合は, エラーログを出力し,
        # 終了コード1 を返して終了する。
        LOGGER.error("Backup failed: %s", exc)
        raise SystemExit(1)
