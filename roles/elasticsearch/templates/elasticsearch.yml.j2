#
# Elasticsearch の基本設定を設定し, backend 用の単一ノード構成にする。
#
# クラスタ名を設定し, ノードが参加するクラスタ識別子を設定する。
cluster.name: "{{ elastic_search_cluster_name }}"
# ノード名を設定し, API やログ上で識別できる表示名を設定する。
node.name: "{{ elastic_search_node_name }}"
# HTTP 待受アドレスを設定し, REST API を公開するインターフェースを制御する。
network.host: "{{ elastic_search_http_host }}"
# HTTP 待受ポートを設定し, クライアント接続の受け口を設定する。
http.port: {{ elastic_search_http_port }}
# ノード探索方式を設定し, 単一ノード構成として起動する動作を設定する。
discovery.type: "{{ elastic_search_discovery_type }}"
# 認証/認可機能の有効/無効を設定する。
xpack.security.enabled: {{ elastic_search_security_enabled | bool | ternary('true', 'false') }}
# HTTP レイヤーTLSの有効/無効を設定する。
xpack.security.http.ssl.enabled: {{ elastic_search_http_ssl_enabled | bool | ternary('true', 'false') }}
{% if elastic_search_http_ssl_enabled | bool %}
# HTTP レイヤーTLS証明書の参照パスを設定する。
xpack.security.http.ssl.certificate: "{{ elastic_search_http_ssl_certificate_container_path }}"
# HTTP レイヤーTLS秘密鍵の参照パスを設定する。
xpack.security.http.ssl.key: "{{ elastic_search_http_ssl_key_container_path }}"
{% endif %}
# ノード間通信TLSの有効/無効を設定する。
xpack.security.transport.ssl.enabled: {{ elastic_search_transport_ssl_enabled | bool | ternary('true', 'false') }}
# Snapshot Repository のルートパスを設定し, filesystem repository を利用可能にする。
path.repo:
  - "{{ elastic_search_snapshot_repo_path_container }}"
