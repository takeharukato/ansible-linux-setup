# Elasticsearch コンテナを backend ネットワーク上で起動する compose 定義である。
#
services:
  # Elasticsearch サービス定義
  elasticsearch:
    # 利用する Elasticsearch イメージを指定する。
    image: "{{ elastic_search_image }}"
    # コンテナ名を設定し, 管理コマンドの対象を明確にする。
    container_name: "{{ elastic_search_container_name }}"
    # ノード構成と JVM 設定を環境変数で渡す。
    environment:
      cluster.name: "{{ elastic_search_cluster_name }}"
      node.name: "{{ elastic_search_node_name }}"
      discovery.type: "{{ elastic_search_discovery_type }}"
      ES_JAVA_OPTS: "{{ elastic_search_java_opts }}"
{% if elastic_search_security_enabled | bool %}
      ELASTIC_PASSWORD: "{{ elastic_search_bootstrap_password }}"
{% endif %}
      # swap を使わない前提でメモリロックを有効化する。
      bootstrap.memory_lock: "true"
    # memlock 制限を外し, memory_lock 設定が有効になるようにする。
    ulimits:
      memlock:
        soft: -1
        hard: -1
    # 設定, データ, ログ, スナップショット をホストへ永続化する。
    volumes:
      - "{{ elastic_search_config_file }}:/usr/share/elasticsearch/config/elasticsearch.yml:ro"
{% if elastic_search_http_ssl_enabled | bool %}
      - "{{ elastic_search_http_ssl_runtime_certificate_host_path }}:{{ elastic_search_http_ssl_certificate_container_path }}:ro"
      - "{{ elastic_search_http_ssl_runtime_key_host_path }}:{{ elastic_search_http_ssl_key_container_path }}:ro"
{% endif %}
      - "{{ elastic_search_data_dir }}:/usr/share/elasticsearch/data"
      - "{{ elastic_search_logs_dir }}:/usr/share/elasticsearch/logs"
      - "{{ elastic_search_snapshot_repo_path_host }}:{{ elastic_search_snapshot_repo_path_container }}"
    # HTTP ポートをホストへ公開し, 外部の verify タスクから疎通確認できるようにする。
    ports:
      - "{{ elastic_search_http_host }}:{{ elastic_search_http_port }}:{{ elastic_search_http_port }}"
    # 異常終了時に自動復旧する。
    restart: unless-stopped
    # コンテナ内部で TCP 受付を確認し, 起動直後の未待受状態を判定できるようにする。
    healthcheck:
      test:
        - CMD-SHELL
        - "bash -c 'exec 3<>/dev/tcp/127.0.0.1/{{ elastic_search_http_port }}'"
      interval: 10s
      timeout: 5s
      retries: 12
    # backend 用の共有ネットワークに参加する。
    networks:
      - elastic_backend

# ネットワーク定義
networks:
  # 既存の external ネットワークへ接続し, backend サービス間通信を統一する。
  elastic_backend:
    external: true
    name: "{{ elastic_search_network_name }}"
