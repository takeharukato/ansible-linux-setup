"""Elastic Stack専用DockerネットワークのCIDRを検証する。"""

from __future__ import annotations

import argparse
import ipaddress
import json
import subprocess
import sys
from typing import Any

NETWORK_MISSING_EXIT_CODE: int = 10


def parse_arguments() -> argparse.Namespace:
    """コマンドライン引数を解析する。

    Returns:
        argparse.Namespace: 検証対象のネットワーク名, CIDR及びタイムアウト値である。

    Examples:
        >>> isinstance(parse_arguments(), argparse.Namespace)  # doctest: +SKIP
        True
    """
    parser: argparse.ArgumentParser = argparse.ArgumentParser()
    parser.add_argument("--network-name", required=True)
    parser.add_argument("--ipv4-subnet", required=True)
    parser.add_argument("--ipv6-subnet", required=True)
    parser.add_argument("--timeout", required=True, type=int)
    return parser.parse_args()


def inspect_networks(timeout_seconds: int) -> list[dict[str, Any]]:
    """Dockerネットワーク一覧を取得する。

    Args:
        timeout_seconds (int): Dockerコマンドの最大実行秒数である。

    Returns:
        list[dict[str, Any]]: Dockerネットワーク情報の一覧である。

    Raises:
        RuntimeError: Dockerネットワーク情報を取得又は解析できない場合に送出する。

    Examples:
        >>> isinstance(inspect_networks(1), list)  # doctest: +SKIP
        True
    """
    try:
        network_ids_result: subprocess.CompletedProcess[str] = subprocess.run(
            ["docker", "network", "ls", "--quiet"],
            check=True,
            capture_output=True,
            text=True,
            timeout=timeout_seconds,
        )
        network_ids: list[str] = network_ids_result.stdout.split()
        if not network_ids:
            return []
        inspect_result: subprocess.CompletedProcess[str] = subprocess.run(
            ["docker", "network", "inspect", *network_ids],
            check=True,
            capture_output=True,
            text=True,
            timeout=timeout_seconds,
        )
        parsed_networks: Any = json.loads(inspect_result.stdout)
    except (subprocess.SubprocessError, json.JSONDecodeError) as error:
        raise RuntimeError(f"Docker network inspection failed: {error}") from error
    if not isinstance(parsed_networks, list):
        raise RuntimeError("Docker network inspection returned a non-list value.")
    return [network for network in parsed_networks if isinstance(network, dict)]


def network_subnets(
    network: dict[str, Any],
) -> list[ipaddress.IPv4Network | ipaddress.IPv6Network]:
    """Dockerネットワーク情報からIPv4/IPv6 CIDRを取得する。

    Args:
        network (dict[str, Any]): Docker network inspectの1ネットワーク分の情報である。

    Returns:
        list[ipaddress.IPv4Network | ipaddress.IPv6Network]: 有効なCIDRの一覧である。

    Examples:
        >>> network_subnets({"IPAM": {"Config": [{"Subnet": "172.18.0.0/16"}, {"Subnet": "fd00:172:18::/64"}]}})
        [IPv4Network('172.18.0.0/16'), IPv6Network('fd00:172:18::/64')]
    """
    ipam: Any = network.get("IPAM", {})
    configurations: Any = ipam.get("Config", []) if isinstance(ipam, dict) else []
    subnets: list[ipaddress.IPv4Network | ipaddress.IPv6Network] = []
    for configuration in configurations if isinstance(configurations, list) else []:
        subnet_value: Any = configuration.get("Subnet") if isinstance(configuration, dict) else None
        if isinstance(subnet_value, str):
            parsed_subnet: ipaddress.IPv4Network | ipaddress.IPv6Network = ipaddress.ip_network(
                subnet_value, strict=False
            )
            subnets.append(parsed_subnet)
    return subnets


def validate_networks(
    networks: list[dict[str, Any]],
    network_name: str,
    expected_subnets: list[ipaddress.IPv4Network | ipaddress.IPv6Network],
) -> int:
    """対象CIDRの一致と他ネットワークとの非重複を検証する。

    Args:
        networks (list[dict[str, Any]]): Dockerネットワーク情報の一覧である。
        network_name (str): 検証対象ネットワーク名である。
        expected_subnets (list[ipaddress.IPv4Network | ipaddress.IPv6Network]): 期待するCIDRである。

    Returns:
        int: 正常時は0, 対象未作成時は10である。

    Raises:
        ValueError: 対象CIDRが不一致又は他ネットワークと重複する場合に送出する。

    Examples:
        >>> validate_networks([], "elastic-backend", [ipaddress.ip_network("172.18.0.0/16"), ipaddress.ip_network("fd00:172:18::/64")])
        10
    """
    target_found: bool = False
    for network in networks:
        current_name: str = str(network.get("Name", ""))
        current_subnets: list[ipaddress.IPv4Network | ipaddress.IPv6Network] = network_subnets(
            network
        )
        if current_name == network_name:
            target_found = True
            if set(current_subnets) != set(expected_subnets):
                raise ValueError(
                    f"Network {network_name} CIDR mismatch: expected={expected_subnets}, actual={current_subnets}"
                )
        else:
            for current_subnet in current_subnets:
                for expected_subnet in expected_subnets:
                    if current_subnet.version == expected_subnet.version and current_subnet.overlaps(
                        expected_subnet
                    ):
                        raise ValueError(
                            f"Network CIDR overlap: network={current_name}, subnet={current_subnet}, expected={expected_subnet}"
                        )
    return 0 if target_found else NETWORK_MISSING_EXIT_CODE


def main() -> int:
    """DockerネットワークCIDR検証を実行する。

    Returns:
        int: 正常時は0, 対象未作成時は10, 検証失敗時は1である。

    Examples:
        >>> main()  # doctest: +SKIP
        0
    """
    arguments: argparse.Namespace = parse_arguments()
    try:
        expected_subnets: list[ipaddress.IPv4Network | ipaddress.IPv6Network] = [
            ipaddress.IPv4Network(arguments.ipv4_subnet, strict=False),
            ipaddress.IPv6Network(arguments.ipv6_subnet, strict=False),
        ]
        networks: list[dict[str, Any]] = inspect_networks(arguments.timeout)
        return validate_networks(networks, arguments.network_name, expected_subnets)
    except (ValueError, RuntimeError) as error:
        print(str(error), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())