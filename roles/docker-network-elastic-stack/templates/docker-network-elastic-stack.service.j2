[Unit]
Description=Elastic Stack Docker network IPv4 and IPv6 egress rules
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart={{ docker_network_elastic_stack_apply_script }}
RemainAfterExit=yes
TimeoutStartSec={{ docker_network_elastic_stack_command_timeout_seconds }}

[Install]
WantedBy=multi-user.target