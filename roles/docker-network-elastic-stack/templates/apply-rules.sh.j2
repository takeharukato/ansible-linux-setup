set -euo pipefail

readonly IPTABLES="$(command -v iptables)"
readonly IP6TABLES="$(command -v ip6tables)"
readonly DOCKER="$(command -v docker)"
readonly NETWORK_NAME="{{ logging_backend_network_name }}"
readonly NETWORK_IPV4_SUBNET="{{ logging_backend_network_ipv4_subnet }}"
readonly NETWORK_IPV6_SUBNET="{{ logging_backend_network_ipv6_subnet }}"
readonly FILTER_CHAIN="{{ docker_network_elastic_stack_filter_chain }}"
readonly NAT_CHAIN="{{ docker_network_elastic_stack_nat_chain }}"
readonly WAIT_SECONDS="{{ docker_network_elastic_stack_command_timeout_seconds }}"

# 必須コマンドが見つからない場合は規則を部分適用せずに停止する。
if [[ -z "${IPTABLES}" || -z "${IP6TABLES}" || -z "${DOCKER}" ]]; then
    printf '%s\n' 'docker, iptables and ip6tables commands are required.' >&2
    exit 1
fi

# Dockerが割り当てたbridge名を取得し, ネットワーク内通信を送信元アドレス変換の対象外にする。
network_id="$(${DOCKER} network inspect --format '{{ '{{' }}.Id{{ '}}' }}' "${NETWORK_NAME}")"
bridge_name="$(${DOCKER} network inspect --format '{{ '{{' }}index .Options "com.docker.network.bridge.name"{{ '}}' }}' "${NETWORK_NAME}")"
if [[ -z "${bridge_name}" || "${bridge_name}" == '<no value>' ]]; then
    bridge_name="br-${network_id:0:12}"
fi

# 専用filterチェーンだけを再生成し, 他ロールが所有する規則を変更しない。
${IPTABLES} -w "${WAIT_SECONDS}" -t filter -N "${FILTER_CHAIN}" 2>/dev/null || true
${IPTABLES} -w "${WAIT_SECONDS}" -t filter -F "${FILTER_CHAIN}"
${IPTABLES} -w "${WAIT_SECONDS}" -t filter -A "${FILTER_CHAIN}" -d "${NETWORK_IPV4_SUBNET}" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
${IPTABLES} -w "${WAIT_SECONDS}" -t filter -A "${FILTER_CHAIN}" -s "${NETWORK_IPV4_SUBNET}" ! -o "${bridge_name}" -j ACCEPT
${IPTABLES} -w "${WAIT_SECONDS}" -t filter -A "${FILTER_CHAIN}" -j RETURN
${IPTABLES} -w "${WAIT_SECONDS}" -t filter -C FORWARD -s "${NETWORK_IPV4_SUBNET}" -j "${FILTER_CHAIN}" 2>/dev/null || \
    ${IPTABLES} -w "${WAIT_SECONDS}" -t filter -I FORWARD 1 -s "${NETWORK_IPV4_SUBNET}" -j "${FILTER_CHAIN}"
${IPTABLES} -w "${WAIT_SECONDS}" -t filter -C FORWARD -d "${NETWORK_IPV4_SUBNET}" -j "${FILTER_CHAIN}" 2>/dev/null || \
    ${IPTABLES} -w "${WAIT_SECONDS}" -t filter -I FORWARD 1 -d "${NETWORK_IPV4_SUBNET}" -j "${FILTER_CHAIN}"

# 専用natチェーンだけを再生成し, Elastic Stack以外のDockerネットワークを変換しない。
${IPTABLES} -w "${WAIT_SECONDS}" -t nat -N "${NAT_CHAIN}" 2>/dev/null || true
${IPTABLES} -w "${WAIT_SECONDS}" -t nat -F "${NAT_CHAIN}"
${IPTABLES} -w "${WAIT_SECONDS}" -t nat -A "${NAT_CHAIN}" ! -o "${bridge_name}" -j MASQUERADE
${IPTABLES} -w "${WAIT_SECONDS}" -t nat -A "${NAT_CHAIN}" -j RETURN
${IPTABLES} -w "${WAIT_SECONDS}" -t nat -C POSTROUTING -s "${NETWORK_IPV4_SUBNET}" -j "${NAT_CHAIN}" 2>/dev/null || \
    ${IPTABLES} -w "${WAIT_SECONDS}" -t nat -A POSTROUTING -s "${NETWORK_IPV4_SUBNET}" -j "${NAT_CHAIN}"

# IPv4と同じ所有境界でIPv6専用filterチェーンを再生成する。
${IP6TABLES} -w "${WAIT_SECONDS}" -t filter -N "${FILTER_CHAIN}" 2>/dev/null || true
${IP6TABLES} -w "${WAIT_SECONDS}" -t filter -F "${FILTER_CHAIN}"
${IP6TABLES} -w "${WAIT_SECONDS}" -t filter -A "${FILTER_CHAIN}" -d "${NETWORK_IPV6_SUBNET}" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
${IP6TABLES} -w "${WAIT_SECONDS}" -t filter -A "${FILTER_CHAIN}" -s "${NETWORK_IPV6_SUBNET}" ! -o "${bridge_name}" -j ACCEPT
${IP6TABLES} -w "${WAIT_SECONDS}" -t filter -A "${FILTER_CHAIN}" -j RETURN
${IP6TABLES} -w "${WAIT_SECONDS}" -t filter -C FORWARD -s "${NETWORK_IPV6_SUBNET}" -j "${FILTER_CHAIN}" 2>/dev/null || \
    ${IP6TABLES} -w "${WAIT_SECONDS}" -t filter -I FORWARD 1 -s "${NETWORK_IPV6_SUBNET}" -j "${FILTER_CHAIN}"
${IP6TABLES} -w "${WAIT_SECONDS}" -t filter -C FORWARD -d "${NETWORK_IPV6_SUBNET}" -j "${FILTER_CHAIN}" 2>/dev/null || \
    ${IP6TABLES} -w "${WAIT_SECONDS}" -t filter -I FORWARD 1 -d "${NETWORK_IPV6_SUBNET}" -j "${FILTER_CHAIN}"

# IPv6だけを提供する外部ネットワークへ到達できるようにIPv6専用natチェーンを再生成する。
${IP6TABLES} -w "${WAIT_SECONDS}" -t nat -N "${NAT_CHAIN}" 2>/dev/null || true
${IP6TABLES} -w "${WAIT_SECONDS}" -t nat -F "${NAT_CHAIN}"
${IP6TABLES} -w "${WAIT_SECONDS}" -t nat -A "${NAT_CHAIN}" ! -o "${bridge_name}" -j MASQUERADE
${IP6TABLES} -w "${WAIT_SECONDS}" -t nat -A "${NAT_CHAIN}" -j RETURN
${IP6TABLES} -w "${WAIT_SECONDS}" -t nat -C POSTROUTING -s "${NETWORK_IPV6_SUBNET}" -j "${NAT_CHAIN}" 2>/dev/null || \
    ${IP6TABLES} -w "${WAIT_SECONDS}" -t nat -A POSTROUTING -s "${NETWORK_IPV6_SUBNET}" -j "${NAT_CHAIN}"