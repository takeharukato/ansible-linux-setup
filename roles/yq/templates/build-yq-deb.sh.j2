#!/usr/bin/env bash
# -*- coding:utf-8 mode:bash -*-
#
# yqのdebパッケージをビルドする
#
# 実行時パラメタ環境変数
#  - YQ_VERSION_TAG: ソース取得用タグ (例: v4.44.3)
#  - YQ_VERSION_NORMALIZED: パッケージ版数 (例: 4.44.3)
#  - YQ_SOURCE_BASE_URL: yqソース取得先ベースURL
#  - YQ_DEB_PACKAGE_NAME: 生成するdebパッケージ名
#  - YQ_COMMAND_PATH: インストール先コマンドパス
#  - YQ_DEB_ARCH: debパッケージ用アーキテクチャ名
#
# This file is generated by ansible.
{# 日付の取得 #}
# last update: {{ '%Y-%m-%d %H:%M:%S %Z' | strftime(ansible_date_time.epoch) }}

set -euo pipefail

: "${YQ_VERSION_TAG:?YQ_VERSION_TAG is required}"
: "${YQ_VERSION_NORMALIZED:?YQ_VERSION_NORMALIZED is required}"
: "${YQ_SOURCE_BASE_URL:?YQ_SOURCE_BASE_URL is required}"
: "${YQ_DEB_PACKAGE_NAME:?YQ_DEB_PACKAGE_NAME is required}"
: "${YQ_COMMAND_PATH:?YQ_COMMAND_PATH is required}"
: "${YQ_DEB_ARCH:?YQ_DEB_ARCH is required}"
: "${YQ_COMPLETION_ENABLED:=false}"
: "${YQ_BASH_COMPLETION_PATH_DEBIAN:=/usr/share/bash-completion/completions/yq}"
: "${YQ_ZSH_COMPLETION_PATH_DEBIAN:=/usr/share/zsh/vendor-completions/_yq}"

YQ_BASH_COMPLETION_PATH="${YQ_BASH_COMPLETION_PATH_DEBIAN}"
YQ_ZSH_COMPLETION_PATH="${YQ_ZSH_COMPLETION_PATH_DEBIAN}"

workdir="{{ yq_build_container_workdir }}"
outdir="${workdir}/output"
stage_dir="${workdir}/yq-deb-stage"
pkgroot="${stage_dir}/root"
control_dir="${pkgroot}/DEBIAN"
src_tarball="${workdir}/yq-${YQ_VERSION_TAG}.tar.gz"
src_dir="${workdir}/yq-${YQ_VERSION_NORMALIZED}"
cmd_parent="$(dirname "${YQ_COMMAND_PATH}")"
bash_completion_parent="$(dirname "${YQ_BASH_COMPLETION_PATH}")"
zsh_completion_parent="$(dirname "${YQ_ZSH_COMPLETION_PATH}")"

is_true() {
    case "${1:-}" in
        true|TRUE|yes|YES|1)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

generate_completion() {
    local shell_name="$1"
    local output_path="$2"

    if "${workdir}/yq" shell-completion "${shell_name}" > "${output_path}" 2>/dev/null; then
        return 0
    fi

    "${workdir}/yq" completion "${shell_name}" > "${output_path}"
}

prepare_tools() {
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install {{ apt_install_opts }} \
        ca-certificates \
        curl \
        git \
        golang-go \
        dpkg-dev \
        file
}

build_yq_binary() {
    local build_target
    local built_binary

    if [ -d "${src_dir}" ]; then
        rm -rf "${src_dir:?}"
    fi

    curl -fsSL "${YQ_SOURCE_BASE_URL}/${YQ_VERSION_TAG}.tar.gz" -o "${src_tarball}"
    tar -xzf "${src_tarball}" -C "${workdir}"

    cd "${src_dir}"
    export CGO_ENABLED=0
    built_binary="${workdir}/yq"

    # yq の版数によってビルド対象パスが異なるため, 存在確認して切り替える
    if [ -d "./cmd/yq" ]; then
        build_target="./cmd/yq"
    else
        build_target="."
    fi

    go build -trimpath -ldflags "-s -w -X github.com/mikefarah/yq/v4/cmd.Version=${YQ_VERSION_TAG}" -o "${built_binary}" "${build_target}"
}

build_package() {
    local installed_size

    if [ -d "${stage_dir}" ]; then
        rm -rf "${stage_dir:?}/"*
    fi

    mkdir -p "${outdir}" "${control_dir}" "${pkgroot}${cmd_parent}"
    install -m 0755 "${workdir}/yq" "${pkgroot}${YQ_COMMAND_PATH}"

    if is_true "${YQ_COMPLETION_ENABLED}"; then
        mkdir -p "${pkgroot}${bash_completion_parent}" "${pkgroot}${zsh_completion_parent}"
        generate_completion bash "${pkgroot}${YQ_BASH_COMPLETION_PATH}"
        generate_completion zsh "${pkgroot}${YQ_ZSH_COMPLETION_PATH}"
        chmod 0644 "${pkgroot}${YQ_BASH_COMPLETION_PATH}" "${pkgroot}${YQ_ZSH_COMPLETION_PATH}"
    fi

    installed_size="$(du -ks "${pkgroot}" | awk '{print $1}')"

    cat > "${control_dir}/control" <<EOF
Package: ${YQ_DEB_PACKAGE_NAME}
Version: ${YQ_VERSION_NORMALIZED}-1
Section: utils
Priority: optional
Architecture: ${YQ_DEB_ARCH}
Maintainer: yq role builder <root@localhost>
Installed-Size: ${installed_size}
Description: yq command line YAML processor ${YQ_VERSION_TAG}
EOF

    dpkg-deb --build "${pkgroot}" "${outdir}/${YQ_DEB_PACKAGE_NAME}_${YQ_VERSION_NORMALIZED}-1_${YQ_DEB_ARCH}.deb"
}

main() {
    prepare_tools
    build_yq_binary
    build_package
}

main "$@"
