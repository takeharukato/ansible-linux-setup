#!/usr/bin/env bash
# -*- coding:utf-8 mode:bash -*-
#
# yqのrpmパッケージをビルドする
#
# 実行時パラメタ環境変数
#  - YQ_VERSION_TAG: ソース取得用タグ (例: v4.44.3)
#  - YQ_VERSION_NORMALIZED: パッケージ版数 (例: 4.44.3)
#  - YQ_SOURCE_BASE_URL: yqソース取得先ベースURL
#  - YQ_RPM_PACKAGE_NAME: 生成するrpmパッケージ名
#  - YQ_COMMAND_PATH: インストール先コマンドパス
#  - YQ_RPM_ARCH: rpmパッケージ用アーキテクチャ名
#
# This file is generated by ansible.
{# 日付の取得 #}
# last update: {{ '%Y-%m-%d %H:%M:%S %Z' | strftime(ansible_date_time.epoch) }}

set -euo pipefail

: "${YQ_VERSION_TAG:?YQ_VERSION_TAG is required}"
: "${YQ_VERSION_NORMALIZED:?YQ_VERSION_NORMALIZED is required}"
: "${YQ_SOURCE_BASE_URL:?YQ_SOURCE_BASE_URL is required}"
: "${YQ_RPM_PACKAGE_NAME:?YQ_RPM_PACKAGE_NAME is required}"
: "${YQ_COMMAND_PATH:?YQ_COMMAND_PATH is required}"
: "${YQ_RPM_ARCH:?YQ_RPM_ARCH is required}"
: "${YQ_COMPLETION_ENABLED:=false}"
: "${YQ_BASH_COMPLETION_PATH_RHEL:=/usr/share/bash-completion/completions/yq}"
: "${YQ_ZSH_COMPLETION_PATH_RHEL:=/usr/share/zsh/site-functions/_yq}"

YQ_BASH_COMPLETION_PATH="${YQ_BASH_COMPLETION_PATH_RHEL}"
YQ_ZSH_COMPLETION_PATH="${YQ_ZSH_COMPLETION_PATH_RHEL}"

workdir="{{ yq_build_container_workdir }}"
outdir="${workdir}/output"
rpmbuild_dir="${workdir}/rpmbuild"
source_tarball="yq-${YQ_VERSION_TAG}.tar.gz"
source_dir_name="yq-${YQ_VERSION_NORMALIZED}"
cmd_parent="$(dirname "${YQ_COMMAND_PATH}")"
bash_completion_parent="$(dirname "${YQ_BASH_COMPLETION_PATH}")"
zsh_completion_parent="$(dirname "${YQ_ZSH_COMPLETION_PATH}")"

is_true() {
    case "${1:-}" in
        true|TRUE|yes|YES|1)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

prepare_tools() {

    # curl-minimal と curl が競合する環境があるため,
    # 先に既存の curl コマンド有無を確認し, 未導入時のみ補完する
    dnf {{ dnf_install_opts }} --disablerepo=epel install \
        ca-certificates \
        git \
        golang \
        rpm-build \
        findutils \
        tar \
        gzip

    if ! command -v curl >/dev/null 2>&1; then
        dnf {{ dnf_install_opts }} --disablerepo=epel install curl-minimal || dnf {{ dnf_install_opts }} --disablerepo=epel install --allowerasing curl
    fi
}

prepare_sources() {
    rm -rf "${rpmbuild_dir}"
    mkdir -p "${rpmbuild_dir}"/{BUILD,BUILDROOT,RPMS,SOURCES,SPECS,SRPMS}
    mkdir -p "${outdir}"

    curl -fsSL "${YQ_SOURCE_BASE_URL}/${YQ_VERSION_TAG}.tar.gz" -o "${rpmbuild_dir}/SOURCES/${source_tarball}"
}

write_spec() {
    local with_completion

    with_completion=0
    if is_true "${YQ_COMPLETION_ENABLED}"; then
        with_completion=1
    fi

    cat > "${rpmbuild_dir}/SPECS/${YQ_RPM_PACKAGE_NAME}.spec" <<EOF
%global debug_package %{nil}
%global _debugsource_packages 0
%global with_completion ${with_completion}
Name:           ${YQ_RPM_PACKAGE_NAME}
Version:        ${YQ_VERSION_NORMALIZED}
Release:        1%{?dist}
Summary:        yq command line YAML processor
License:        MIT
URL:            https://github.com/mikefarah/yq
Source0:        ${source_tarball}
BuildArch:      ${YQ_RPM_ARCH}

%description
yq command line YAML processor ${YQ_VERSION_TAG}

%prep
%setup -q -n ${source_dir_name}

%build
export CGO_ENABLED=0
if [ -d ./cmd/yq ]; then
    build_target=./cmd/yq
else
    build_target=.
fi
go build -trimpath -ldflags "-s -w -X github.com/mikefarah/yq/v4/cmd.Version=${YQ_VERSION_TAG}" -o "%{_builddir}/${source_dir_name}/yq" "\${build_target}"
if [ 0%{?with_completion} -eq 1 ]; then
    if ./yq shell-completion bash > yq.bash-completion 2>/dev/null; then
        :
    else
        ./yq completion bash > yq.bash-completion
    fi

    if ./yq shell-completion zsh > yq.zsh-completion 2>/dev/null; then
        :
    else
        ./yq completion zsh > yq.zsh-completion
    fi
fi

%install
rm -rf %{buildroot}
mkdir -p %{buildroot}${cmd_parent}
install -m 0755 "%{_builddir}/${source_dir_name}/yq" %{buildroot}${YQ_COMMAND_PATH}

if [ 0%{?with_completion} -eq 1 ]; then
    mkdir -p %{buildroot}${bash_completion_parent}
    mkdir -p %{buildroot}${zsh_completion_parent}
    install -m 0644 yq.bash-completion %{buildroot}${YQ_BASH_COMPLETION_PATH}
    install -m 0644 yq.zsh-completion %{buildroot}${YQ_ZSH_COMPLETION_PATH}
fi

%files
${YQ_COMMAND_PATH}
%if 0%{?with_completion}
${YQ_BASH_COMPLETION_PATH}
${YQ_ZSH_COMPLETION_PATH}
%endif
EOF
}

build_package() {
    rpmbuild -bb "${rpmbuild_dir}/SPECS/${YQ_RPM_PACKAGE_NAME}.spec" --define "_topdir ${rpmbuild_dir}"
    find "${rpmbuild_dir}/RPMS" -type f -name '*.rpm' -exec cp -f {} "${outdir}/" \;
}

main() {
    prepare_tools
    prepare_sources
    write_spec
    build_package
}

main "$@"
