agent:
  fleet:
    enabled: true
    url: "{{ elastic_agent_k8s_audit_runtime_fleet_server_url }}"
    token: "{{ elastic_agent_k8s_audit_runtime_enrollment_token }}"
    insecure: {{ elastic_agent_k8s_audit_runtime_insecure | bool | lower }}
    preset: perNode

  presets:
    perNode:
      mode: daemonset

      serviceAccount:
        create: true

      clusterRole:
        create: true

      hostNetwork: false

      nodeSelector:
{{ elastic_agent_k8s_audit_node_selector | to_nice_yaml(indent=2) | indent(8, true) }}

      tolerations:
{{ elastic_agent_k8s_audit_tolerations | to_nice_yaml(indent=2) | indent(8, true) }}

      statePersistence: HostPath

      resources:
{{ elastic_agent_k8s_audit_resources | to_nice_yaml(indent=2) | indent(8, true) }}

      extraVolumes:
        - name: kubernetes-audit-log
          hostPath:
            path: "{{ elastic_agent_k8s_audit_host_log_dir }}"
            type: Directory

      extraVolumeMounts:
        - name: kubernetes-audit-log
          mountPath: "{{ elastic_agent_k8s_audit_container_log_dir }}"
          readOnly: true

      providers:
        kubernetes:
          node: ${NODE_NAME}
          scope: node

      agent:
        monitoring:
          namespace: "{{ elastic_agent_k8s_audit_runtime_data_stream_namespace }}"
          use_output: default
          enabled: {{ elastic_agent_k8s_audit_runtime_monitoring_enabled | bool | lower }}
          logs: {{ elastic_agent_k8s_audit_runtime_monitoring_logs_enabled | bool | lower }}
          metrics: {{ elastic_agent_k8s_audit_runtime_monitoring_metrics_enabled | bool | lower }}

kubernetes:
  enabled: false

system:
  enabled: false

kube-state-metrics:
  enabled: false
