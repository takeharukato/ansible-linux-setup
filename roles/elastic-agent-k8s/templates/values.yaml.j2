{% raw %}
# Fleet Serverへ登録するElastic Agentの接続設定。
# 設定する値は次のとおりである:
# - enabled: Fleet管理を有効化する。
# - url: 接続先Fleet ServerのURLを設定する。
# - token: Fleet Server登録時に使用するEnrollment Tokenを設定する。
# - insecure: trueの場合は証明書検証を省略し, falseの場合は証明書検証を実施する。
#
# 各Jinja2式の説明:
#
# - Fleet Serverの接続先URLは実行時に確定したURLを設定する
#   ({{ elastic_agent_k8s_runtime_fleet_server_url }})。
# - Enrollment Tokenは実行時に取得した値を設定する
#   ({{ elastic_agent_k8s_runtime_enrollment_token }})。
# - insecureはAnsibleの真偽値を元に,
#   trueの場合は証明書検証を省略し, falseの場合は証明書検証を
#   実施するようJSON形式のtrue/falseへ変換して設定する。
#   ({{ elastic_agent_k8s_runtime_insecure | to_json }})。
# - preset: Cluster全体の情報を収集するclusterWide構成を選択する。
#
{% endraw %}
agent:
  fleet:
    enabled: true
    url: "{{ elastic_agent_k8s_runtime_fleet_server_url }}"
    token: "{{ elastic_agent_k8s_runtime_enrollment_token }}"
    insecure: {{ elastic_agent_k8s_runtime_insecure | to_json }}
    preset: clusterWide

{% raw %}
# clusterWide 構成の Elastic Agent Pod resources を変数で指定する。
# 変換処理の対応関係: 辞書変数を YAML へ変換し, resources 配下へ配置する
# ({{ elastic_agent_k8s_clusterwide_resources | to_nice_yaml(indent=2) | indent(8, True) }})。
{% endraw %}
