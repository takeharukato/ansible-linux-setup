    clusterWide:
      resources:
{{ elastic_agent_k8s_clusterwide_resources | to_nice_yaml(indent=2) | indent(8, True) }}

# Kubernetes統合のクラスタ状態情報を収集するため有効化する。
kube-state-metrics:
  enabled: true
