#
#  -*- coding:utf-8 mode: yaml -*-
# This file is generated by ansible.
#
# 生成日時は epoch 秒を日時文字列へ変換して記録する。
# 変換処理の対応関係: 書式指定('%Y-%m-%d %H:%M:%S %Z') + epoch値(ansible_date_time.epoch) を strftime へ渡す ({{ '%Y-%m-%d %H:%M:%S %Z' | strftime(ansible_date_time.epoch) }})。
# last update: {{ '%Y-%m-%d %H:%M:%S %Z' | strftime(ansible_date_time.epoch) }}
#
# Metricbeat の基本設定を設定し, backend の Logstash へ送信する。
#
# モジュール定義を開始し, 収集対象メトリクス群を設定する。
metricbeat.modules:
  # system モジュールを有効化し, OS とプロセスの稼働情報を収集する。
  - module: system
    # 収集周期を設定し, 各メトリクスの取得間隔を制御する。
    period: {{ metricbeat_system_period }}
    # 収集するメトリクス種別一覧を設定し, 必要な観測項目だけを有効化する。
    metricsets:
      # CPU 使用率メトリクスを収集する。
      - cpu
      # 負荷平均メトリクスを収集する。
      - load
      # メモリ使用量メトリクスを収集する。
      - memory
      # ネットワーク I/O メトリクスを収集する。
      - network
      # プロセス単位メトリクスを収集する。
      - process
      # プロセス集約サマリを収集する。
      - process_summary
      # ソケット集約サマリを収集する。
      - socket_summary
      # ファイルシステム単位メトリクスを収集する。
      - filesystem
      # ファイルシステム全体統計を収集する。
      - fsstat
# イベント加工処理を設定し, 送信イベントへホスト情報と識別情報を付加する。
processors:
  # ホストメタデータ付与を有効化し, 送信イベントに送信元ノード情報を埋め込む。
  - add_host_metadata: {}
  # 固定フィールド追加を有効化し, 収集系統を示す識別子をイベントへ付与する。
  - add_fields:
      # 追加先をルートへ設定し, fields 配下を最上位キーとして格納する。
      target: ""
      # 追加する固定フィールド群を定義する。
      fields:
        # collector 名を設定し, downstream 側で metricbeat 起点データを識別可能にする。
        collector: "metricbeat"

# Logstash 出力先を設定し, 収集イベントを backend の集約先へ転送する。
output.logstash:
  # 出力先ホストとポートを設定し, TCP 接続先を一意に決定する。
  hosts: ["{{ metricbeat_backend_host }}:{{ metricbeat_backend_port }}"]

# HTTP 監視 API を有効化し, 稼働状態確認とメトリクス取得を可能にする。
http.enabled: true
# HTTP 監視 API の待受アドレスを設定し, 監視エンドポイントの公開範囲を制御する。
http.host: "{{ metricbeat_http_host }}"
# HTTP 監視 API の待受ポートを設定し, 監視接続の受け口を設定する。
http.port: {{ metricbeat_http_port }}

# 権限チェックを緩和し, コンテナ内マウント構成でも設定読込を継続できるようにする。
strict.perms: false
