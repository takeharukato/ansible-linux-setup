# This file is generated by ansible.
#
# 生成日時は epoch 秒を日時文字列へ変換して記録する。
# 変換処理の対応関係: 書式指定('%Y-%m-%d %H:%M:%S %Z') + epoch値(ansible_date_time.epoch) を strftime へ渡す ({{ '%Y-%m-%d %H:%M:%S %Z' | strftime(ansible_date_time.epoch) }})。
# last update: {{ '%Y-%m-%d %H:%M:%S %Z' | strftime(ansible_date_time.epoch) }}
#
# Metricbeat コンテナを collector 用に起動する compose 定義である。
#
services:
  # Metricbeat サービス定義
  metricbeat:
    # 利用する Metricbeat イメージを指定する。
    image: "{{ metricbeat_image }}"
    # コンテナ名を設定し, 運用時の識別を容易にする。
    container_name: "{{ metricbeat_container_name }}"
    # ホストメトリクスを参照するため root 権限で実行する。
    user: root
    # 使用する設定ファイルと hostfs 参照先を明示して起動する。
    command:
      # 実行バイナリを指定し, Metricbeat プロセスを起動する。
      - metricbeat
      # 標準エラー出力へログを出力し, コンテナログ収集基盤で観測可能にする。
      - -e
      # 使用する設定ファイルの指定オプションを有効化する。
      - -c
      # 読み込む設定ファイルのパスを設定し, テンプレート生成結果を実行時設定として使用する。
      - /usr/share/metricbeat/metricbeat.yml
      # system モジュールの hostfs 参照先を設定し, ホスト OS 情報を正しく解決する。
      - --system.hostfs=/hostfs
    # 設定ファイル, hostfs, データ, ログをマウントし, メトリクス収集に必要な参照先を提供する。
    volumes:
      # Metricbeat 設定ファイルを読み取り専用で渡し, 実行時設定の改変を防止する。
      - "{{ metricbeat_compose_dir }}/metricbeat.yml:/usr/share/metricbeat/metricbeat.yml:ro"
      # ルートファイルシステムを hostfs として読み取り専用で公開し, ホスト資源参照の基点にする。
      - "/:/hostfs:ro"
      # procfs を読み取り専用で公開し, プロセス関連メトリクス収集を可能にする。
      - "/proc:/hostfs/proc:ro"
      # cgroup 情報を読み取り専用で公開し, 制御グループ関連メトリクス収集を可能にする。
      - "/sys/fs/cgroup:/hostfs/sys/fs/cgroup:ro"
      # Metricbeat の内部状態保存領域を永続化し, 再起動後も収集状態を保持する。
      - "{{ metricbeat_data_dir }}:/usr/share/metricbeat/data"
      # Metricbeat の自己ログ出力先を永続化し, 障害解析で参照できるようにする。
      - "{{ metricbeat_logs_dir }}:/usr/share/metricbeat/logs"
    # HTTP 監視ポートをホストへ公開し, collector の健全性確認に使用する。
    ports:
      # ホストの待受アドレスとポートをコンテナへ対応付けし, 監視エンドポイントへ到達可能にする。
      - "{{ metricbeat_http_host }}:{{ metricbeat_http_port }}:{{ metricbeat_http_port }}"
    # 異常終了時に自動復旧する。
    restart: unless-stopped
