#
# Network Attachment Definition (NAD)の設定
#

apiVersion: k8s.cni.cncf.io/v1
kind: NetworkAttachmentDefinition
metadata:
  name: ipvlan-wb
  namespace: kube-system
spec:
  config: |
    {
      {# Container Network Interface (CNI) 仕様の版数
      ipvlan, whereabouts, bridgeの各CNI, および,
      Container Runtime (containerd)のCNIライブラリが対応している版数を指定する。
      多くの CNI/IPAM ( ipvlan・whereabouts 含む )が確実に対応している版数である
      0.3.1を指定
      #}
      "cniVersion": "0.3.1",
      {# セカンダリCNIとして, ipvlanを使用 #}
      "type": "ipvlan",
      {# 検証用NADはKubernetesネットワーク側NICへ接続する #}
      "master": "{{k8s_whereabouts_runtime_nad_nic_name}}",
      {# L2接続 #}
      "mode": "l2",
      {# IP Address Manager (IPAM)にwhereaboutsを使用 #}
      "ipam": {
        "type": "whereabouts",
        {#
        IPv4とIPv6のアドレス付与範囲をipRangesへ列挙する。
        IPv4のみ, IPv6のみ, IPv4/IPv6 Dual Stackの各構成に対応する。
        #}
        "ipRanges": [
      {% if k8s_whereabouts_runtime_ipv4_cidr is defined and (k8s_whereabouts_runtime_ipv4_cidr | string | length) > 0
            and k8s_whereabouts_ipv4_range_start is defined and (k8s_whereabouts_ipv4_range_start | string | length) > 0
            and k8s_whereabouts_ipv4_range_end is defined and (k8s_whereabouts_ipv4_range_end | string | length) > 0 %}
          {
            {# Kubernetesネットワーク側NICのIPv4ネットワークCIDR #}
            "range": "{{k8s_whereabouts_runtime_ipv4_cidr}}",
            {#
            IPv4アドレス付与範囲
            物理サーバのIPアドレス範囲と重複しないようにする
            #}
            "range_start": "{{k8s_whereabouts_ipv4_range_start}}",
            "range_end": "{{k8s_whereabouts_ipv4_range_end}}"
          }{% if k8s_whereabouts_runtime_ipv6_cidr is defined and (k8s_whereabouts_runtime_ipv6_cidr | string | length) > 0
                and k8s_whereabouts_ipv6_range_start is defined and (k8s_whereabouts_ipv6_range_start | string | length) > 0
                and k8s_whereabouts_ipv6_range_end is defined and (k8s_whereabouts_ipv6_range_end | string | length) > 0 %},{% endif %}
      {% endif %}
      {% if k8s_whereabouts_runtime_ipv6_cidr is defined and (k8s_whereabouts_runtime_ipv6_cidr | string | length) > 0
            and k8s_whereabouts_ipv6_range_start is defined and (k8s_whereabouts_ipv6_range_start | string | length) > 0
            and k8s_whereabouts_ipv6_range_end is defined and (k8s_whereabouts_ipv6_range_end | string | length) > 0 %}
          {
            {#
            IPv6アドレス付与範囲
            IPv6 (Kubernetesネットワーク側NICのIPv6アドレスに合わせる)
            #}
            "range": "{{k8s_whereabouts_runtime_ipv6_cidr}}",
            "range_start": "{{k8s_whereabouts_ipv6_range_start}}",
            "range_end": "{{k8s_whereabouts_ipv6_range_end}}"
          }
      {% endif %}
        ],
        {# ログファイル出力先 #}
        "log_file": "/var/log/whereabouts.log",
        {# ログレベル #}
        "log_level": "info"
      }
    }
