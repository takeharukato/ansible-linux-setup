#
# filebeatのrpmパッケージをビルドする
#
# 実行時パラメタ環境変数
#  - FILEBEAT_VERSION_TAG: ソース取得用タグ (例: v8.17.3)
#  - FILEBEAT_VERSION_NORMALIZED: パッケージ版数 (例: 8.17.3)
#  - FILEBEAT_SOURCE_BASE_URL: filebeatソース取得先ベースURL
#  - FILEBEAT_RPM_PACKAGE_NAME: 生成するrpmパッケージ名
#  - FILEBEAT_RPM_ARCH: rpmパッケージ用アーキテクチャ名
#
# This file is generated by ansible.
#
# 生成日時は epoch 秒を日時文字列へ変換して記録する。
# 変換処理の対応関係: 書式指定('%Y-%m-%d %H:%M:%S %Z') + epoch値(ansible_date_time.epoch) を strftime へ渡す ({{ '%Y-%m-%d %H:%M:%S %Z' | strftime(ansible_date_time.epoch) }})。
# last update: {{ '%Y-%m-%d %H:%M:%S %Z' | strftime(ansible_date_time.epoch) }}
#

set -euo pipefail

# 環境変数の必須チェック
# FILEBEAT_VERSION_TAG: ソース取得用タグ (例: v8.17.3)
# FILEBEAT_VERSION_NORMALIZED: パッケージ版数 (例: 8.17.3)
# FILEBEAT_SOURCE_BASE_URL: filebeatソース取得先ベースURL
# FILEBEAT_RPM_PACKAGE_NAME: 生成するrpmパッケージ名
# FILEBEAT_RPM_ARCH: rpmパッケージ用アーキテクチャ名
: "${FILEBEAT_VERSION_TAG:?FILEBEAT_VERSION_TAG is required}"
: "${FILEBEAT_VERSION_NORMALIZED:?FILEBEAT_VERSION_NORMALIZED is required}"
: "${FILEBEAT_SOURCE_BASE_URL:?FILEBEAT_SOURCE_BASE_URL is required}"
: "${FILEBEAT_RPM_PACKAGE_NAME:?FILEBEAT_RPM_PACKAGE_NAME is required}"
: "${FILEBEAT_RPM_ARCH:?FILEBEAT_RPM_ARCH is required}"

#
# 作業ディレクトリと出力ディレクトリの設定
#
# workdir: ビルド作業用ディレクトリ
# outdir: ビルド成果物出力ディレクトリ
# rpmbuild_dir: rpmbuild作業ディレクトリ
# source_tarball: filebeatソース取得用tarballファイル名
# source_dir_name: filebeatソース展開先ディレクトリ名
workdir="{{ filebeat_build_container_workdir }}"
outdir="${workdir}/output"
rpmbuild_dir="${workdir}/rpmbuild"
source_tarball="filebeat-${FILEBEAT_VERSION_TAG}.tar.gz"
source_dir_name="beats-${FILEBEAT_VERSION_NORMALIZED}"

#
# パッケージ構築用のツールをインストールする。
#
prepare_tools() {

    # rpmパッケージ構築に必要なツールをインストールする。
    dnf install -y \
        ca-certificates \
        git \
        golang \
        rpm-build \
        findutils \
        tar \
        gzip \
        make

    # curlコマンドが見つからない場合のみ代替パッケージを導入する。
    # curl-minimalで失敗した場合は, 依存競合を許可してcurlを導入する。
    if ! command -v curl >/dev/null 2>&1; then
        dnf install -y curl-minimal || dnf install -y --allowerasing curl
    fi
}

#
# filebeatのソースを取得して, rpmbuild用ディレクトリを準備する。
#
prepare_sources() {

    # 既存のrpmbuild作業ディレクトリが存在する場合は削除する。
    rm -rf "${rpmbuild_dir}"

    # rpmbuildの標準ディレクトリ構成と成果物出力ディレクトリを作成する。
    mkdir -p "${rpmbuild_dir}"/{BUILD,BUILDROOT,RPMS,SOURCES,SPECS,SRPMS}
    mkdir -p "${outdir}"

    # filebeatソースtarballをSOURCESディレクトリに配置する。
    curl -fsSL "${FILEBEAT_SOURCE_BASE_URL}/${FILEBEAT_VERSION_TAG}.tar.gz" -o "${rpmbuild_dir}/SOURCES/${source_tarball}"
}

#
# rpmbuildで使用するspecファイルを生成する。
#
write_spec() {

    # specファイルにはビルド手順, インストール先, 同梱ファイルを定義する。
    cat > "${rpmbuild_dir}/SPECS/${FILEBEAT_RPM_PACKAGE_NAME}.spec" <<EOF
%global debug_package %{nil}
%global _debugsource_packages 0
Name:           ${FILEBEAT_RPM_PACKAGE_NAME}
Version:        ${FILEBEAT_VERSION_NORMALIZED}
Release:        1%{?dist}
Summary:        filebeat log collector
License:        Elastic License 2.0
URL:            https://github.com/elastic/beats
Source0:        ${source_tarball}
BuildArch:      ${FILEBEAT_RPM_ARCH}

%description
filebeat log collector ${FILEBEAT_VERSION_TAG}

%prep
%setup -q -n ${source_dir_name}

%build
export CGO_ENABLED=0
cd ./filebeat
go build -trimpath -ldflags "-s -w" -o "%{_builddir}/${source_dir_name}/filebeat-bin" .

%install
rm -rf %{buildroot}
mkdir -p %{buildroot}/usr/local/bin
install -m 0755 "%{_builddir}/${source_dir_name}/filebeat-bin" %{buildroot}/usr/local/bin/filebeat

%files
/usr/local/bin/filebeat
EOF
}

#
# specファイルに基づいてrpmパッケージを構築し, 成果物を出力ディレクトリへ集約する。
#
build_package() {

    # rpmbuildを実行してRPMを生成する。
    rpmbuild -bb "${rpmbuild_dir}/SPECS/${FILEBEAT_RPM_PACKAGE_NAME}.spec" --define "_topdir ${rpmbuild_dir}"

    # 生成されたrpmファイルを成果物ディレクトリへコピーする。
    find "${rpmbuild_dir}/RPMS" -type f -name '*.rpm' -exec cp -f {} "${outdir}/" \;
}

# メイン処理
main() {
    prepare_tools
    prepare_sources
    write_spec
    build_package
}

main "$@"
