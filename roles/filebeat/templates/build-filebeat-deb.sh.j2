#
# filebeatのdebパッケージをビルドする
#
# 実行時パラメタ環境変数
#  - FILEBEAT_VERSION_TAG: ソース取得用タグ (例: v8.17.3)
#  - FILEBEAT_VERSION_NORMALIZED: パッケージ版数 (例: 8.17.3)
#  - FILEBEAT_SOURCE_BASE_URL: filebeatソース取得先ベースURL
#  - FILEBEAT_DEB_PACKAGE_NAME: 生成するdebパッケージ名
#  - FILEBEAT_DEB_ARCH: debパッケージ用アーキテクチャ名
#
# This file is generated by ansible.
#
# 生成日時は epoch 秒を日時文字列へ変換して記録する。
# 変換処理の対応関係: 書式指定('%Y-%m-%d %H:%M:%S %Z') + epoch値(ansible_date_time.epoch) を strftime へ渡す ({{ '%Y-%m-%d %H:%M:%S %Z' | strftime(ansible_date_time.epoch) }})。
# last update: {{ '%Y-%m-%d %H:%M:%S %Z' | strftime(ansible_date_time.epoch) }}
#

set -euo pipefail

# 環境変数の必須チェック
# FILEBEAT_VERSION_TAG: ソース取得用タグ (例: v8.17.3)
# FILEBEAT_VERSION_NORMALIZED: パッケージ版数 (例: 8.17.3)
# FILEBEAT_SOURCE_BASE_URL: filebeatソース取得先ベースURL
# FILEBEAT_DEB_PACKAGE_NAME: 生成するdebパッケージ名
# FILEBEAT_DEB_ARCH: debパッケージ用アーキテクチャ名
: "${FILEBEAT_VERSION_TAG:?FILEBEAT_VERSION_TAG is required}"
: "${FILEBEAT_VERSION_NORMALIZED:?FILEBEAT_VERSION_NORMALIZED is required}"
: "${FILEBEAT_SOURCE_BASE_URL:?FILEBEAT_SOURCE_BASE_URL is required}"
: "${FILEBEAT_DEB_PACKAGE_NAME:?FILEBEAT_DEB_PACKAGE_NAME is required}"
: "${FILEBEAT_DEB_ARCH:?FILEBEAT_DEB_ARCH is required}"

#
# 作業ディレクトリと出力ディレクトリの設定
#
# workdir: ビルド作業用ディレクトリ
# outdir: ビルド成果物出力ディレクトリ
# stage_dir: debパッケージ構築用ステージングディレクトリ
# pkgroot: debパッケージ構築用ルートディレクトリ
# control_dir: debパッケージ構築用コントロールディレクトリ
# src_tarball: filebeatソース取得用tarballファイルパス
# src_dir: filebeatソース展開先ディレクトリ
workdir="{{ filebeat_build_container_workdir }}"
outdir="${workdir}/output"
stage_dir="${workdir}/filebeat-deb-stage"
pkgroot="${stage_dir}/root"
control_dir="${pkgroot}/DEBIAN"
src_tarball="${workdir}/filebeat-${FILEBEAT_VERSION_TAG}.tar.gz"
src_dir="${workdir}/beats-${FILEBEAT_VERSION_NORMALIZED}"

#
# パッケージ構築用のツールをインストールする。
#
prepare_tools() {

    # 非対話型モードで apt-get を実行するための環境変数を設定する。
    # 対話処理によって処理が停止することを防止するための対策
    export DEBIAN_FRONTEND=noninteractive

    # apt-get update を実行し, パッケージリストを更新する。
    apt-get update

    # debパッケージ構築に必要なツールをインストールする。
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        golang-go \
        make \
        dpkg-dev \
        tar \
        gzip
}

#
# filebeatバイナリをビルドする。
#
build_filebeat_binary() {

    # 既存のソースディレクトリが存在する場合は削除する。
    if [ -d "${src_dir}" ]; then
        rm -rf "${src_dir:?}"
    fi

    # filebeatソースを取得する。
    curl -fsSL "${FILEBEAT_SOURCE_BASE_URL}/${FILEBEAT_VERSION_TAG}.tar.gz" -o "${src_tarball}"
    # filebeatソースを展開する。
    tar -xzf "${src_tarball}" -C "${workdir}"

    #
    # パッケージをビルドする。
    # 1. filebeatソースディレクトリに移動する。
    # 2. 環境変数 CGO_ENABLED=0 を設定し, cgo (C言語との連携機能) を無効化する。
    # 3. go build コマンドを実行し, filebeatバイナリをビルドする。
    (
        cd "${src_dir}"
        export CGO_ENABLED=0
        go build -trimpath -ldflags "-s -w" -o "${workdir}/filebeat" ./filebeat
    )
}

#
# debパッケージを構築する。
#
build_package() {
    local installed_size

    # 既存のステージングディレクトリが存在する場合は削除する。
    if [ -d "${stage_dir}" ]; then
        rm -rf "${stage_dir:?}/"*
    fi

    # ステージングディレクトリとコントロールディレクトリを作成する。
    mkdir -p "${outdir}" "${control_dir}" "${pkgroot}/usr/local/bin"
    install -m 0755 "${workdir}/filebeat" "${pkgroot}/usr/local/bin/filebeat"

    # インストールサイズを計算する。
    installed_size="$(du -ks "${pkgroot}" | awk '{print $1}')"

    # Debianパッケージのコントロールファイルを作成する。
    cat > "${control_dir}/control" <<EOF
Package: ${FILEBEAT_DEB_PACKAGE_NAME}
Version: ${FILEBEAT_VERSION_NORMALIZED}-1
Section: utils
Priority: optional
Architecture: ${FILEBEAT_DEB_ARCH}
Maintainer: filebeat role builder <root@localhost>
Installed-Size: ${installed_size}
Description: filebeat log collector ${FILEBEAT_VERSION_TAG}
EOF

    # debパッケージを構築する。
    dpkg-deb --build "${pkgroot}" "${outdir}/${FILEBEAT_DEB_PACKAGE_NAME}_${FILEBEAT_VERSION_NORMALIZED}-1_${FILEBEAT_DEB_ARCH}.deb"
}

# メイン処理
main() {

    prepare_tools
    build_filebeat_binary
    build_package
}

main "$@"
