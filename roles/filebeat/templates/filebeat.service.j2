[Unit]
Description=Filebeat Log Collector Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={{ filebeat_command }} -e -c {{ filebeat_config_file }} --path.home {{ filebeat_config_dir }} --path.config {{ filebeat_config_dir }} --path.data {{ filebeat_data_dir }} --path.logs {{ filebeat_logs_dir }}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
