#
#  -*- coding:utf-8 mode: yaml -*-
# This file is generated by ansible.
#
# 生成日時は epoch 秒を日時文字列へ変換して記録する。
# 変換処理の対応関係: 書式指定('%Y-%m-%d %H:%M:%S %Z') + epoch値(ansible_date_time.epoch) を strftime へ渡す ({{ '%Y-%m-%d %H:%M:%S %Z' | strftime(ansible_date_time.epoch) }})。
# last update: {{ '%Y-%m-%d %H:%M:%S %Z' | strftime(ansible_date_time.epoch) }}
#
# Filebeat の基本設定を設定し, backend の Logstash へ送信する。
#
# ログ入力定義を開始し, どの種類のログ収集を有効化するかを設定する。
filebeat.inputs:
  # filestream 入力を使用し, ファイル追記を追従してログを収集する。
  - type: filestream
    # 入力 ID を設定し, 内部状態と監視情報でこの入力を識別できるようにする。
    id: vm-system-logs
    # 入力を有効化し, この filestream 定義を起動対象にする。
    enabled: true
    # 収集対象パス定義を開始し, 監視するログファイルを列挙する。
    paths:
    # 収集対象パス一覧を順に展開して filestream の paths へ並べる。
    # 展開処理の対応関係: 反復対象(filebeat_log_paths) を for で取り出し, 各要素(path) を paths 配列要素へ出力する ({% for path in filebeat_log_paths %} ... "{{ path }}" ... {% endfor %})。
{% for path in filebeat_log_paths %}
      - "{{ path }}"
{% endfor %}

# イベント加工処理を設定し, 収集イベントへホスト情報と識別情報を付加する。
processors:
  # ホストメタデータ付与を有効化し, 送信イベントに送信元ノード情報を埋め込む。
  - add_host_metadata: {}
  # 固定フィールド追加を有効化し, 収集系統を示す識別子をイベントへ付与する。
  - add_fields:
      # 追加先をルートへ設定し, fields 配下を最上位キーとして格納する。
      target: ""
      # 追加する固定フィールド群を定義する。
      fields:
        # collector 名を設定し, downstream 側で filebeat 起点データを識別可能にする。
        collector: "filebeat"

# Logstash 出力先を設定し, 収集イベントを backend の集約先へ転送する。
output.logstash:
  # 出力先ホストとポートを設定し, TCP 接続先を一意に決定する。
  hosts: ["{{ filebeat_backend_host }}:{{ filebeat_backend_port }}"]

# HTTP 監視 API を有効化し, 稼働状態確認とメトリクス取得を可能にする。
http.enabled: true
# HTTP 監視 API の待受アドレスを設定し, 監視エンドポイントの公開範囲を制御する。
http.host: "{{ filebeat_http_host }}"
# HTTP 監視 API の待受ポートを設定し, 監視接続の受け口を設定する。
http.port: {{ filebeat_http_port }}

# 権限チェックを緩和し, コンテナ内マウント構成でも設定読込を継続できるようにする。
strict.perms: false
