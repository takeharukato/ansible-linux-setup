#
#  -*- coding:utf-8 mode: yaml -*-
# This file is generated by ansible.
#
# 生成日時は epoch 秒を日時文字列へ変換して記録する。
# 変換処理の対応関係: 書式指定('%Y-%m-%d %H:%M:%S %Z') + epoch値(ansible_date_time.epoch) を strftime へ渡す ({{ '%Y-%m-%d %H:%M:%S %Z' | strftime(ansible_date_time.epoch) }})。
# last update: {{ '%Y-%m-%d %H:%M:%S %Z' | strftime(ansible_date_time.epoch) }}
#
# Filebeat コンテナを collector 用に起動する compose 定義である。
#
services:
  # Filebeat サービス定義
  filebeat:
    # 利用する Filebeat イメージを指定する。
    image: "{{ filebeat_image }}"
    # コンテナ名を設定し, 運用時の識別を容易にする。
    container_name: "{{ filebeat_container_name }}"
    # ホストログを参照するため root 権限で実行する。
    user: root
    # 使用する設定ファイルを明示して起動する。
    command:
      # 実行バイナリを指定し, Filebeat プロセスを起動する。
      - filebeat
      # 標準エラー出力へログを出力し, コンテナログ収集基盤で観測可能にする。
      - -e
      # 使用する設定ファイルの指定オプションを有効化する。
      - -c
      # 読み込む設定ファイルのパスを設定し, テンプレート生成結果を実行時設定として使用する。
      - /usr/share/filebeat/filebeat.yml
    # 設定ファイルとホストログを読み取り専用でマウントし, データとログは永続化する。
    volumes:
      # Filebeat 設定ファイルを読み取り専用で渡し, 実行時設定の改変を防止する。
      - "{{ filebeat_compose_dir }}/filebeat.yml:/usr/share/filebeat/filebeat.yml:ro"
      # ホストの汎用ログディレクトリを読み取り専用で公開し, OS ログを収集対象にする。
      - "/var/log:/var/log:ro"
      # Docker コンテナログを読み取り専用で公開し, コンテナ単位ログを収集対象にする。
      - "/var/lib/docker/containers:/var/lib/docker/containers:ro"
      # Kubernetes コンテナログのシンボリックリンク元を読み取り専用で公開する。
      - "/var/log/containers:/var/log/containers:ro"
      # Kubernetes Pod ログディレクトリを読み取り専用で公開し, Pod 単位ログを収集対象にする。
      - "/var/log/pods:/var/log/pods:ro"
      # Filebeat の内部状態保存領域を永続化し, 再起動後の読み取り位置を保持する。
      - "{{ filebeat_data_dir }}:/usr/share/filebeat/data"
      # Filebeat の自己ログ出力先を永続化し, 障害解析で参照できるようにする。
      - "{{ filebeat_logs_dir }}:/usr/share/filebeat/logs"
    # HTTP 監視ポートをホストへ公開し, collector の健全性確認に使用する。
    ports:
      # ホストの待受アドレスとポートをコンテナへ対応付けし, 監視エンドポイントへ到達可能にする。
      - "{{ filebeat_http_host }}:{{ filebeat_http_port }}:{{ filebeat_http_port }}"
    # 異常終了時に自動復旧する。
    restart: unless-stopped
