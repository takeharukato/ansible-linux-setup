# Kibana の基本設定を設定し, backend 用の単一接続先にする。
#
# HTTP 待受アドレスを設定し, Kibana の Web UI を公開するインターフェースを制御する。
server.host: "{{ kibana_server_host }}"
# HTTP 待受ポートを設定し, 利用者が Web UI へ接続する受け口を設定する。
server.port: {{ kibana_server_port }}
# Elasticsearch 接続先を設定し, Kibana が検索データ取得と管理 API 呼び出しを行う宛先を設定する。
elasticsearch.hosts: ["{{ kibana_internal_elasticsearch_hosts }}"]
# FleetのLogstash出力用秘密情報を保存可能にするため, 永続化した暗号化キーを設定する。
xpack.encryptedSavedObjects.encryptionKey: "{{ kibana_encrypted_saved_objects_encryption_key }}"