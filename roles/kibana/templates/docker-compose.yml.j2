# Kibana コンテナを backend ネットワーク上で起動する compose 定義である。
#
services:
  # Kibana サービス定義
  kibana:
    # 利用する Kibana イメージを指定する。
    image: "{{ kibana_image }}"
    # コンテナ名を設定し, 運用時の識別を容易にする。
    container_name: "{{ kibana_container_name }}"
    # バインドアドレス, 公開ポート, Elasticsearch 接続先を環境変数で指定する。
    environment:
      # Kibana の待受アドレスを設定し, Web UI の公開インターフェースを制御する。
      SERVER_HOST: "{{ kibana_server_host }}"
      # Kibana の待受ポートを設定し, 利用者が接続する受け口を設定する。
      SERVER_PORT: "{{ kibana_server_port }}"
      # Elasticsearch 接続先 URL を設定し, ダッシュボード表示用データ取得先を設定する。
      ELASTICSEARCH_HOSTS: "{{ kibana_internal_elasticsearch_hosts }}"
    {% if kibana_elasticsearch_security_enabled | bool %}
      # Elasticsearch Security 有効時の service account token を設定する。
      ELASTICSEARCH_SERVICEACCOUNTTOKEN: "{{ kibana_service_token_value }}"
    {% endif %}
    # 設定, データ, ログをホスト側へ保持する。
    volumes:
      # Kibana 設定ファイルを読み取り専用で渡し, 意図しない設定改変を防止する。
      - "{{ kibana_compose_dir }}/kibana.yml:/usr/share/kibana/config/kibana.yml:ro"
      # Kibana データ領域を永続化し, 再起動後も内部状態を保持する。
      - "{{ kibana_data_dir }}:/usr/share/kibana/data"
      # Kibana ログ出力先を永続化し, 監査と障害調査で参照できるようにする。
      - "{{ kibana_logs_dir }}:/usr/share/kibana/logs"
    # Kibana の HTTP ポートをホストへ公開する。
    ports:
      # ホストの待受アドレスとポートをコンテナへ対応付けし, 外部から Web UI へ到達可能にする。
      - "{{ kibana_server_host }}:{{ kibana_server_port }}:{{ kibana_server_port }}"
    # 異常終了時に自動復旧する。
    restart: unless-stopped
    # backend 用の共有ネットワークに参加する。
    networks:
      - elastic_backend

# ネットワーク定義
networks:
  # 既存の external ネットワークへ接続し, backend サービス間通信を統一する。
  elastic_backend:
    # Compose で新規作成せず, 既存ネットワークを利用する。
    external: true
    # 接続する既存ネットワーク名を設定し, ロール間で同一ネットワークへ参加させる。
    name: "{{ kibana_network_name }}"